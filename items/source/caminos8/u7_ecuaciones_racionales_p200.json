  {"id":"CS8-U7-P200-A158","tipo":"abierta","enunciado":"Determina si 1/3=a/x+b/3 es una ecuación racional, considerando x como incógnita y a,b como constantes no nulas.","respuesta":"Sí. Es racional porque la incógnita x aparece en el denominador de una fracción algebraica.","conjunto":"R","seccion":"Identificación de ecuaciones racionales","unidad":7,"pagina_pdf":200,"referencia":"Actividad 158","apto_para":["procedimiento_abierto"],"dificultad":350},
