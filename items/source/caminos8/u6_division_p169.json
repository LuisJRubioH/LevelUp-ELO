[
  {"id":"CS8-U6-P169-A185","tipo":"simbolico","enunciado":"Completa y simplifica 12x²y³/(18ab) ÷ 6x⁴y/(9a²b³).","expr":"12*x**2*y**3/(18*a*b)/(6*x**4*y/(9*a**2*b**3))","respuesta":"a*b**2*y**2/x**2","respuesta_texto":"Se multiplica por el recíproco 9a²b³/(6x⁴y) y se obtiene ab²y²/x².","conjunto":"R","seccion":"División de fracciones algebraicas","unidad":6,"pagina_pdf":169,"referencia":"Actividad 185","apto_para":["practica","procedimiento_abierto"],"dificultad":500},
  {"id":"CS8-U6-P169-A186","tipo":"simbolico","enunciado":"Completa y simplifica (2a−7)/(3b²) ÷ (4a−14)/(24b).","expr":"(2*a-7)/(3*b**2)/((4*a-14)/(24*b))","respuesta":"4/b","respuesta_texto":"Se multiplica por 24b/(4a−14) y se obtiene 4/b.","conjunto":"R","seccion":"División de fracciones algebraicas","unidad":6,"pagina_pdf":169,"referencia":"Actividad 186","apto_para":["practica","procedimiento_abierto"],"dificultad":500},
  {"id":"CS8-U6-P169-A187","tipo":"simbolico","enunciado":"Completa las casillas de 20x²y/(□) ÷ 30x²/(□), sabiendo que al invertir el divisor aparecen 34ab⁴ y 17a²b³; luego simplifica.","expr":"20*x**2*y/(34*a*b**4)/(30*x**2/(17*a**2*b**3))","respuesta":"a*y/(3*b)","respuesta_texto":"Las casillas son 34ab⁴ y 17a²b³; queda 20x²y/(34ab⁴) · 17a²b³/(30x²)=ay/(3b).","conjunto":"R","seccion":"División de fracciones algebraicas","unidad":6,"pagina_pdf":169,"referencia":"Actividad 187","apto_para":["practica","procedimiento_abierto"],"dificultad":550},
  {"id":"CS8-U6-P169-A188","tipo":"simbolico","enunciado":"Relaciona 35n²/(18m³) ÷ 14nm²/(9m³) con su cociente.","expr":"35*n**2/(18*m**3)/(14*n*m**2/(9*m**3))","respuesta":"5*n/(4*m**2)","respuesta_texto":"Opción d: 5n/(4m²).","conjunto":"R","seccion":"Cocientes de fracciones algebraicas","unidad":6,"pagina_pdf":169,"referencia":"Actividad 188","apto_para":["practica","procedimiento_abierto"],"dificultad":500},
  {"id":"CS8-U6-P169-A189","tipo":"simbolico","enunciado":"Relaciona 24n²m/(54nm⁴) ÷ 9m³/n³ con su cociente.","expr":"24*n**2*m/(54*n*m**4)/(9*m**3/n**3)","respuesta":"4*n**4/(81*m**6)","respuesta_texto":"Opción c: 4n⁴/(81m⁶).","conjunto":"R","seccion":"Cocientes de fracciones algebraicas","unidad":6,"pagina_pdf":169,"referencia":"Actividad 189","apto_para":["practica","procedimiento_abierto"],"dificultad":550},
  {"id":"CS8-U6-P169-A190","tipo":"simbolico","enunciado":"Relaciona (n³+n)/(n²−n) ÷ (n³−n²)/(n²−2n+1) con su cociente.","expr":"(n**3+n)/(n**2-n)/((n**3-n**2)/(n**2-2*n+1))","respuesta":"(n**2+1)/n**2","respuesta_texto":"Opción e: (n²+1)/n².","conjunto":"R","seccion":"Cocientes de fracciones algebraicas","unidad":6,"pagina_pdf":169,"referencia":"Actividad 190","apto_para":["practica","procedimiento_abierto"],"dificultad":600},
  {"id":"CS8-U6-P169-A191","tipo":"simbolico","enunciado":"Relaciona (m²+8m+16)/(m²+2m−8) ÷ (m²−2m−3)/(m²−3m+2) con su cociente.","expr":"(m**2+8*m+16)/(m**2+2*m-8)/((m**2-2*m-3)/(m**2-3*m+2))","respuesta":"(m**2+3*m-4)/(m**2-2*m-3)","respuesta_texto":"Opción b: (m²+3m−4)/(m²−2m−3).","conjunto":"R","seccion":"Cocientes de fracciones algebraicas","unidad":6,"pagina_pdf":169,"referencia":"Actividad 191","apto_para":["practica","procedimiento_abierto"],"dificultad":650},
  {"id":"CS8-U6-P169-A192","tipo":"simbolico","enunciado":"Relaciona (m²+14m+48)/(m²+4m−21) ÷ (m²+4m−32)/(m²+3m−28) con su cociente.","expr":"(m**2+14*m+48)/(m**2+4*m-21)/((m**2+4*m-32)/(m**2+3*m-28))","respuesta":"(m+6)/(m-3)","respuesta_texto":"Opción a: (m+6)/(m−3).","conjunto":"R","seccion":"Cocientes de fracciones algebraicas","unidad":6,"pagina_pdf":169,"referencia":"Actividad 192","apto_para":["practica","procedimiento_abierto"],"dificultad":600},
  {"id":"CS8-U6-P169-A193","tipo":"simbolico","enunciado":"Determina si el recíproco de (1−x)/(x+1) es −(x+1)/(x−1).","expr":"(x+1)/(1-x)","afirmacion":"-(x+1)/(x-1)","veredicto":"V","respuesta":"-(x+1)/(x-1)","respuesta_texto":"Verdadero, para los valores donde la fracción y su recíproco están definidos.","conjunto":"R","seccion":"Recíprocos y división","unidad":6,"pagina_pdf":169,"referencia":"Actividad 193","apto_para":["practica","procedimiento_abierto"],"dificultad":450},
  {"id":"CS8-U6-P169-A194","tipo":"abierta","enunciado":"Determina si el cociente de dos fracciones algebraicas nunca es un número entero y justifica.","respuesta":"Falso. Por ejemplo, (x/1) ÷ (x/2)=2, para x≠0.","conjunto":"R","seccion":"Propiedades de la división","unidad":6,"pagina_pdf":169,"referencia":"Actividad 194","apto_para":["procedimiento_abierto"],"dificultad":450},
  {"id":"CS8-U6-P169-A195","tipo":"abierta","enunciado":"Determina si la división de tres fracciones algebraicas siempre da el mismo resultado sin importar el orden de las divisiones y justifica.","respuesta":"Falso. La división no es asociativa; por ejemplo, (8÷4)÷2=1, mientras que 8÷(4÷2)=4.","conjunto":"R","seccion":"Propiedades de la división","unidad":6,"pagina_pdf":169,"referencia":"Actividad 195","apto_para":["procedimiento_abierto"],"dificultad":450},
  {"id":"CS8-U6-P169-A196","tipo":"simbolico","enunciado":"Si n+m=36 y nm=9, calcula [(n²−m²)/(m²n²)] ÷ [(n−m)/(mn)].","expr":"36/9","respuesta":"4","respuesta_texto":"La expresión se reduce a (n+m)/(mn); al sustituir los datos resulta 36/9=4.","conjunto":"R","seccion":"Aplicación de identidades en divisiones","unidad":6,"pagina_pdf":169,"referencia":"Actividad 196","apto_para":["practica","procedimiento_abierto"],"dificultad":550},
  {"id":"CS8-U6-P169-A197","tipo":"simbolico","enunciado":"Resuelve (2a³+7a²−4a)/(a²−16) ÷ (2a²−15a+7)/(a³−11a²+28) ÷ (a+4)/(a−4), de izquierda a derecha.","expr":"(2*a**3+7*a**2-4*a)/(a**2-16)/((2*a**2-15*a+7)/(a**3-11*a**2+28))/((a+4)/(a-4))","respuesta":"a*(a**3-11*a**2+28)/((a-7)*(a+4))","conjunto":"R","seccion":"Divisiones sucesivas","unidad":6,"pagina_pdf":169,"referencia":"Actividad 197","apto_para":["practica","procedimiento_abierto"],"erratum":"El denominador está impreso como a³−11a²+28. Probablemente se omitió una a final: con a³−11a²+28a la expresión factorizaría de forma elemental y daría a²(a−4)/(a+4).","verificar":"La ampliación a 400 dpi confirma que la página imprime +28 sin una variable a posterior.","dificultad":750},
  {"id":"CS8-U6-P169-A198","tipo":"simbolico","enunciado":"Resuelve (16n²−24mn+9m²)/(16n−12m) ÷ (64n³−27m³)/(32n²+24mn+18m²).","expr":"(16*n**2-24*m*n+9*m**2)/(16*n-12*m)/((64*n**3-27*m**3)/(32*n**2+24*m*n+18*m**2))","respuesta":"1/2","conjunto":"R","seccion":"División de fracciones algebraicas","unidad":6,"pagina_pdf":169,"referencia":"Actividad 198","apto_para":["practica","procedimiento_abierto"],"dificultad":700},
  {"id":"CS8-U6-P169-A199","tipo":"simbolico","enunciado":"Resuelve (y³+2y²−3y)/(4y²+8y+3) ÷ (y²−y)/(2y²+3y).","expr":"(y**3+2*y**2-3*y)/(4*y**2+8*y+3)/((y**2-y)/(2*y**2+3*y))","respuesta":"y*(y+3)/(2*y+1)","conjunto":"R","seccion":"División de fracciones algebraicas","unidad":6,"pagina_pdf":169,"referencia":"Actividad 199","apto_para":["practica","procedimiento_abierto"],"dificultad":650},
  {"id":"CS8-U6-P169-A200","tipo":"simbolico","enunciado":"Resuelve (2x²+7x−15)/(x³+4x²) ÷ (x²−3x−40)/(x²−4x−32).","expr":"(2*x**2+7*x-15)/(x**3+4*x**2)/((x**2-3*x-40)/(x**2-4*x-32))","respuesta":"(2*x-3)/x**2","conjunto":"R","seccion":"División de fracciones algebraicas","unidad":6,"pagina_pdf":169,"referencia":"Actividad 200","apto_para":["practica","procedimiento_abierto"],"dificultad":650},
  {"id":"CS8-U6-P169-A201","tipo":"simbolico","enunciado":"Un paralelogramo tiene área 45x²y⁴/(14z³) y base 60x²y³/(7z²). Determina su altura.","expr":"(45*x**2*y**4/(14*z**3))/(60*x**2*y**3/(7*z**2))","respuesta":"3*y/(8*z)","conjunto":"R","seccion":"Alturas a partir del área","unidad":6,"pagina_pdf":169,"referencia":"Actividad 201","apto_para":["practica","procedimiento_abierto"],"verificar":"El área y la base se transcribieron de la figura del paralelogramo.","dificultad":550},
  {"id":"CS8-U6-P169-A202","tipo":"simbolico","enunciado":"Un triángulo tiene área (x²+2xy+3y²)/(x²−y²) y base (x+y)/(x−y). Determina su altura.","expr":"2*(x**2+2*x*y+3*y**2)/(x**2-y**2)/((x+y)/(x-y))","respuesta":"2*(x**2+2*x*y+3*y**2)/(x+y)**2","conjunto":"R","seccion":"Alturas a partir del área","unidad":6,"pagina_pdf":169,"referencia":"Actividad 202","apto_para":["practica","procedimiento_abierto"],"verificar":"El área y la base se transcribieron de la figura del triángulo.","dificultad":600}
]
