[
  {"id":"CS8-U6-P158-A108","tipo":"simbolico","enunciado":"Ubica las expresiones 4x²y², 6xy, 12x²y⁴, 2xy y 3 en los espacios para obtener (6xy³+2xy+1)/(2xy).","expr":"12*x**2*y**4/(4*x**2*y**2)+3/(6*x*y)+(4*x**2*y**2)/(4*x**2*y**2)","respuesta":"(6*x*y**3+2*x*y+1)/(2*x*y)","respuesta_texto":"12x²y⁴/(4x²y²) + 3/(6xy) + 4x²y²/(4x²y²) = (6xy³+2xy+1)/(2xy).","conjunto":"R","seccion":"Suma de fracciones con igual denominador","unidad":6,"pagina_pdf":158,"referencia":"Actividad 108","apto_para":["practica","procedimiento_abierto"],"verificar":"La suma es correcta; el orden de los sumandos puede variar y la ficha 4x²y² se usa en tres casillas del diagrama.","dificultad":550},
  {"id":"CS8-U6-P158-A109","tipo":"simbolico","enunciado":"Ubica las expresiones 5m, 8m²n³, mn³ y 11m en los espacios para obtener 2/(mn³).","expr":"5*m/(8*m**2*n**3)+11*m/(8*m**2*n**3)","respuesta":"2/(m*n**3)","respuesta_texto":"5m/(8m²n³) + 11m/(8m²n³) = 2/(mn³).","conjunto":"R","seccion":"Suma de fracciones con igual denominador","unidad":6,"pagina_pdf":158,"referencia":"Actividad 109","apto_para":["practica","procedimiento_abierto"],"dificultad":500},
  {"id":"CS8-U6-P158-A110","tipo":"simbolico","enunciado":"Ubica las expresiones x+6, 3x², 12x², 5x² y 4x² en los espacios para completar la resta de fracciones.","expr":"12*x**2/(x+6)-3*x**2/(x+6)-4*x**2/(x+6)","respuesta":"5*x**2/(x+6)","respuesta_texto":"12x²/(x+6) - 3x²/(x+6) - 4x²/(x+6) = 5x²/(x+6).","conjunto":"R","seccion":"Resta de fracciones con igual denominador","unidad":6,"pagina_pdf":158,"referencia":"Actividad 110","apto_para":["practica","procedimiento_abierto"],"verificar":"Los dos sustraendos pueden intercambiarse sin modificar el resultado.","dificultad":500},
  {"id":"CS8-U6-P158-A111","tipo":"simbolico","enunciado":"Resuelve 2x²y/(x+y) + 5x³y/(x+y).","expr":"2*x**2*y/(x+y)+5*x**3*y/(x+y)","respuesta":"x**2*y*(5*x+2)/(x+y)","conjunto":"R","seccion":"Suma y resta con igual denominador","unidad":6,"pagina_pdf":158,"referencia":"Actividad 111","apto_para":["practica","procedimiento_abierto"],"dificultad":450},
  {"id":"CS8-U6-P158-A112","tipo":"simbolico","enunciado":"Resuelve 12a⁴b³c/(15abc²) - 7a⁴b³c/(15abc²) - 30a⁴b³c/(15abc²).","expr":"12*a**4*b**3*c/(15*a*b*c**2)-7*a**4*b**3*c/(15*a*b*c**2)-30*a**4*b**3*c/(15*a*b*c**2)","respuesta":"-5*a**3*b**2/(3*c)","conjunto":"R","seccion":"Suma y resta con igual denominador","unidad":6,"pagina_pdf":158,"referencia":"Actividad 112","apto_para":["practica","procedimiento_abierto"],"dificultad":500},
  {"id":"CS8-U6-P158-A113","tipo":"simbolico","enunciado":"Resuelve m²/(m-n) - n²/(m-n).","expr":"m**2/(m-n)-n**2/(m-n)","respuesta":"m+n","conjunto":"R","seccion":"Suma y resta con igual denominador","unidad":6,"pagina_pdf":158,"referencia":"Actividad 113","apto_para":["practica","procedimiento_abierto"],"dificultad":450},
  {"id":"CS8-U6-P158-A114","tipo":"simbolico","enunciado":"Resuelve (5x²+10x)/(x²+3x-10) - (x+2)/(x²+3x-10).","expr":"(5*x**2+10*x)/(x**2+3*x-10)-(x+2)/(x**2+3*x-10)","respuesta":"(x+2)*(5*x-1)/((x-2)*(x+5))","conjunto":"R","seccion":"Suma y resta con igual denominador","unidad":6,"pagina_pdf":158,"referencia":"Actividad 114","apto_para":["practica","procedimiento_abierto"],"dificultad":550},
  {"id":"CS8-U6-P158-A115","tipo":"simbolico","enunciado":"Resuelve (4x+1)/(x-1) + (3x-6)/(x-1).","expr":"(4*x+1)/(x-1)+(3*x-6)/(x-1)","respuesta":"(7*x-5)/(x-1)","conjunto":"R","seccion":"Suma y resta con igual denominador","unidad":6,"pagina_pdf":158,"referencia":"Actividad 115","apto_para":["practica","procedimiento_abierto"],"dificultad":400},
  {"id":"CS8-U6-P158-A116","tipo":"simbolico","enunciado":"Resuelve (5a-3)/(a+2) - (2a+5)/(a+2).","expr":"(5*a-3)/(a+2)-(2*a+5)/(a+2)","respuesta":"(3*a-8)/(a+2)","conjunto":"R","seccion":"Suma y resta con igual denominador","unidad":6,"pagina_pdf":158,"referencia":"Actividad 116","apto_para":["practica","procedimiento_abierto"],"dificultad":400},
  {"id":"CS8-U6-P158-A117","tipo":"simbolico","enunciado":"Resuelve (4mn²-3m²n)/(m³+n³) + (m³-mn²)/(m³+n³) + (mn²-4n³)/(m³+n³).","expr":"(4*m*n**2-3*m**2*n)/(m**3+n**3)+(m**3-m*n**2)/(m**3+n**3)+(m*n**2-4*n**3)/(m**3+n**3)","respuesta":"(m-2*n)*(m**2-m*n+2*n**2)/((m+n)*(m**2-m*n+n**2))","conjunto":"R","seccion":"Suma y resta con igual denominador","unidad":6,"pagina_pdf":158,"referencia":"Actividad 117","apto_para":["practica","procedimiento_abierto"],"dificultad":650},
  {"id":"CS8-U6-P158-A118","tipo":"simbolico","enunciado":"Resuelve (x²y-7xy)/(10x²+xy-21y²) - (7xy-x²y-xy²)/(10x²+xy-21y²) - (21y²-2xy²)/(10x²+xy-21y²).","expr":"(x**2*y-7*x*y)/(10*x**2+x*y-21*y**2)-(7*x*y-x**2*y-x*y**2)/(10*x**2+x*y-21*y**2)-(21*y**2-2*x*y**2)/(10*x**2+x*y-21*y**2)","respuesta":"y*(x-7)/(5*x-7*y)","conjunto":"R","seccion":"Suma y resta con igual denominador","unidad":6,"pagina_pdf":158,"referencia":"Actividad 118","apto_para":["practica","procedimiento_abierto"],"dificultad":700},
  {"id":"CS8-U6-P158-A119","tipo":"abierta","enunciado":"Escribe tres fracciones algebraicas de igual denominador cuya suma sea 2/(7x²y).","respuesta":"Ejemplo: 1/(7x²y) + 2/(7x²y) - 1/(7x²y).","conjunto":"R","seccion":"Construcción de sumas de fracciones","unidad":6,"pagina_pdf":158,"referencia":"Actividad 119","apto_para":["procedimiento_abierto"],"dificultad":450},
  {"id":"CS8-U6-P158-A120","tipo":"abierta","enunciado":"Escribe tres fracciones algebraicas de igual denominador cuya suma sea -4/(mn³).","respuesta":"Ejemplo: -1/(mn³) - 1/(mn³) - 2/(mn³).","conjunto":"R","seccion":"Construcción de sumas de fracciones","unidad":6,"pagina_pdf":158,"referencia":"Actividad 120","apto_para":["procedimiento_abierto"],"dificultad":450},
  {"id":"CS8-U6-P158-A121","tipo":"abierta","enunciado":"Escribe tres fracciones algebraicas de igual denominador cuya suma sea (8-x)/(xy³).","respuesta":"Ejemplo: 1/(xy³) + 2/(xy³) + (5-x)/(xy³).","conjunto":"R","seccion":"Construcción de sumas de fracciones","unidad":6,"pagina_pdf":158,"referencia":"Actividad 121","apto_para":["procedimiento_abierto"],"dificultad":450},
  {"id":"CS8-U6-P158-A122","tipo":"abierta","enunciado":"Escribe tres fracciones algebraicas de igual denominador cuya suma sea (4n-1)/(2n).","respuesta":"Ejemplo: 2n/(2n) + 2n/(2n) - 1/(2n).","conjunto":"R","seccion":"Construcción de sumas de fracciones","unidad":6,"pagina_pdf":158,"referencia":"Actividad 122","apto_para":["procedimiento_abierto"],"dificultad":450},
  {"id":"CS8-U6-P158-A123","tipo":"abierta","enunciado":"Escribe tres fracciones algebraicas de igual denominador cuya suma sea (3a²-1)/(6a-4).","respuesta":"Ejemplo: a²/(6a-4) + a²/(6a-4) + (a²-1)/(6a-4).","conjunto":"R","seccion":"Construcción de sumas de fracciones","unidad":6,"pagina_pdf":158,"referencia":"Actividad 123","apto_para":["procedimiento_abierto"],"dificultad":500},
  {"id":"CS8-U6-P158-A124","tipo":"abierta","enunciado":"Escribe tres fracciones algebraicas de igual denominador cuya suma sea (2x+7)/(x²+6x+5).","respuesta":"Ejemplo: x/(x²+6x+5) + x/(x²+6x+5) + 7/(x²+6x+5).","conjunto":"R","seccion":"Construcción de sumas de fracciones","unidad":6,"pagina_pdf":158,"referencia":"Actividad 124","apto_para":["procedimiento_abierto"],"dificultad":500},
  {"id":"CS8-U6-P158-A125","tipo":"abierta","enunciado":"Escribe tres fracciones algebraicas de igual denominador cuya suma sea (4y+1)/(2y²-3y-9).","respuesta":"Ejemplo: 2y/(2y²-3y-9) + 2y/(2y²-3y-9) + 1/(2y²-3y-9).","conjunto":"R","seccion":"Construcción de sumas de fracciones","unidad":6,"pagina_pdf":158,"referencia":"Actividad 125","apto_para":["procedimiento_abierto"],"dificultad":500},
  {"id":"CS8-U6-P158-A126","tipo":"abierta","enunciado":"Escribe tres fracciones algebraicas de igual denominador cuya suma sea (10x-x²-29)/(x²-49).","respuesta":"Ejemplo: 5x/(x²-49) + 5x/(x²-49) + (-x²-29)/(x²-49).","conjunto":"R","seccion":"Construcción de sumas de fracciones","unidad":6,"pagina_pdf":158,"referencia":"Actividad 126","apto_para":["procedimiento_abierto"],"dificultad":500},
  {"id":"CS8-U6-P158-A127","tipo":"simbolico","enunciado":"Simplifica 7(a²-2a+1)/(5a²-8a+3).","expr":"7*(a**2-2*a+1)/(5*a**2-8*a+3)","respuesta":"7*(a-1)/(5*a-3)","conjunto":"R","seccion":"Simplificación de resultados","unidad":6,"pagina_pdf":158,"referencia":"Actividad 127","apto_para":["practica","procedimiento_abierto"],"dificultad":500},
  {"id":"CS8-U6-P158-A128","tipo":"simbolico","enunciado":"Simplifica (3-2x)/(x²+x-2).","expr":"(3-2*x)/(x**2+x-2)","respuesta":"(3-2*x)/((x-1)*(x+2))","conjunto":"R","seccion":"Simplificación de resultados","unidad":6,"pagina_pdf":158,"referencia":"Actividad 128","apto_para":["practica","procedimiento_abierto"],"dificultad":450},
  {"id":"CS8-U6-P158-A129","tipo":"simbolico","enunciado":"Simplifica -(a²+7a+6)/(10a+5).","expr":"-(a**2+7*a+6)/(10*a+5)","respuesta":"-(a+1)*(a+6)/(5*(2*a+1))","conjunto":"R","seccion":"Simplificación de resultados","unidad":6,"pagina_pdf":158,"referencia":"Actividad 129","apto_para":["practica","procedimiento_abierto"],"dificultad":500},
  {"id":"CS8-U6-P158-A130","tipo":"simbolico","enunciado":"Un rectángulo tiene lados (x+6)/(2x+4) y (3x-6)/(2x+4). Calcula su perímetro.","expr":"2*(x+6)/(2*x+4)+2*(3*x-6)/(2*x+4)","respuesta":"4*x/(x+2)","conjunto":"R","seccion":"Aplicaciones geométricas","unidad":6,"pagina_pdf":158,"referencia":"Actividad 130","apto_para":["practica","procedimiento_abierto"],"verificar":"Las dos medidas se transcribieron de la figura del rectángulo.","dificultad":500},
  {"id":"CS8-U6-P158-A131","tipo":"simbolico","enunciado":"Un trapecio isósceles tiene bases (6y-1)/(y²-1) y (y²-5y)/(y²-1), y dos lados iguales de (y²-2)/(y²-1). Calcula su perímetro.","expr":"(6*y-1)/(y**2-1)+(y**2-5*y)/(y**2-1)+2*(y**2-2)/(y**2-1)","respuesta":"(3*y**2+y-5)/(y**2-1)","conjunto":"R","seccion":"Aplicaciones geométricas","unidad":6,"pagina_pdf":158,"referencia":"Actividad 131","apto_para":["practica","procedimiento_abierto"],"verificar":"Las tres medidas se transcribieron de la figura del trapecio.","dificultad":550},
  {"id":"CS8-U6-P158-A132","tipo":"simbolico","enunciado":"Un triángulo tiene dos lados iguales de (x²+10x+5)/(x²+x-6) y un tercer lado de (2x²+38x+8)/(x²+x-6). Calcula su perímetro.","expr":"2*(x**2+10*x+5)/(x**2+x-6)+(2*x**2+38*x+8)/(x**2+x-6)","respuesta":"2*(2*x**2+29*x+9)/((x-2)*(x+3))","conjunto":"R","seccion":"Aplicaciones geométricas","unidad":6,"pagina_pdf":158,"referencia":"Actividad 132","apto_para":["practica","procedimiento_abierto"],"verificar":"Las medidas y la igualdad de dos lados se transcribieron de la figura del triángulo.","dificultad":600}
