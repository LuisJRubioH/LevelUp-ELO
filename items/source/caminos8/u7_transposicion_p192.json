  {"id":"CS8-U7-P192-A80","tipo":"ecuacion","enunciado":"Completa x+___=2x−1 para que x=5 sea la solución.","ecuacion":"5+b=2*5-1","incognita":"b","soluciones":["4"],"respuesta":"El número que completa la ecuación es 4.","conjunto":"N","seccion":"Completar ecuaciones a partir de una solución","unidad":7,"pagina_pdf":192,"referencia":"Actividad 80","apto_para":["practica","procedimiento_abierto"],"dificultad":300},
