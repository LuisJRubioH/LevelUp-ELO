[
  {"id":"CS8-U7-P192-A75","tipo":"abierta","enunciado":"Describe el procedimiento para resolver una ecuación de la forma ax±b=cx±d.","respuesta":"Se transponen los términos con la incógnita a un miembro y los términos independientes al otro, se reducen los términos semejantes y se divide entre el coeficiente resultante de la incógnita, siempre que sea distinto de cero.","conjunto":"R","seccion":"Transposición de términos","unidad":7,"pagina_pdf":192,"referencia":"Actividad 75","apto_para":["procedimiento_abierto"],"dificultad":350},
  {"id":"CS8-U7-P192-A76","tipo":"abierta","enunciado":"Explica qué significa transponer términos en una ecuación.","respuesta":"Transponer un término significa pasarlo de un miembro al otro con la operación inversa; por ejemplo, un sumando pasa restando. Esto equivale a efectuar la misma operación en ambos miembros y conserva la equivalencia de la ecuación.","conjunto":"R","seccion":"Transposición de términos","unidad":7,"pagina_pdf":192,"referencia":"Actividad 76","apto_para":["procedimiento_abierto"],"dificultad":350},
  {"id":"CS8-U7-P192-A77","tipo":"ecuacion","enunciado":"Completa 5x=4x+___ para que x=7 sea la solución.","ecuacion":"5*7=4*7+b","incognita":"b","soluciones":["7"],"respuesta":"El número que completa la ecuación es 7.","conjunto":"N","seccion":"Completar ecuaciones a partir de una solución","unidad":7,"pagina_pdf":192,"referencia":"Actividad 77","apto_para":["practica","procedimiento_abierto"],"dificultad":300},
  {"id":"CS8-U7-P192-A78","tipo":"ecuacion","enunciado":"Completa −3x=x+___ para que x=−2 sea la solución.","ecuacion":"-3*(-2)=-2+b","incognita":"b","soluciones":["8"],"respuesta":"El número que completa la ecuación es 8.","conjunto":"N","seccion":"Completar ecuaciones a partir de una solución","unidad":7,"pagina_pdf":192,"referencia":"Actividad 78","apto_para":["practica","procedimiento_abierto"],"dificultad":300},
