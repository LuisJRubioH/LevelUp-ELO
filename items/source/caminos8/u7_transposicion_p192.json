  {"id":"CS8-U7-P192-A85","tipo":"ecuacion","enunciado":"Resuelve (3/4)x−1/5=3/10+(1/4)x.","ecuacion":"(3/4)*x-1/5=3/10+(1/4)*x","incognita":"x","soluciones":["1"],"respuesta":"x=1","conjunto":"Q","seccion":"Ecuaciones de la forma ax±b=cx±d","unidad":7,"pagina_pdf":192,"referencia":"Actividad 85","apto_para":["practica","procedimiento_abierto"],"dificultad":500},
