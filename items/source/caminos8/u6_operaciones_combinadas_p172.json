[
  {"id":"CS8-U6-P172-A203","tipo":"abierta","enunciado":"Explica con un ejemplo cómo resolver operaciones combinadas que no involucren signos de agrupación.","respuesta":"Primero se efectúan multiplicaciones y divisiones, de izquierda a derecha; después sumas y restas, también de izquierda a derecha. Ejemplo: 2+3·4−6÷2=2+12−3=11.","conjunto":"R","seccion":"Jerarquía de operaciones","unidad":6,"pagina_pdf":172,"referencia":"Actividad 203","apto_para":["procedimiento_abierto"],"dificultad":400},
  {"id":"CS8-U6-P172-A204","tipo":"abierta","enunciado":"Explica por qué es necesario usar signos de agrupación en operaciones combinadas de fracciones algebraicas.","respuesta":"Los signos de agrupación indican qué expresiones completas actúan como numerador, denominador o término de una operación y fijan un orden que evita interpretaciones diferentes. Por ejemplo, a/(b+c) no equivale a a/b+c.","conjunto":"R","seccion":"Jerarquía de operaciones","unidad":6,"pagina_pdf":172,"referencia":"Actividad 204","apto_para":["procedimiento_abierto"],"dificultad":400},
  {"id":"CS8-U6-P172-A205","tipo":"simbolico","enunciado":"Introduce signos de agrupación en x−2−4/(x+1)·x+4x/3 para obtener (7x³−7x²−42x)/(3x+3).","expr":"(x-2-4/(x+1))*(x+4*x/3)","respuesta":"(7*x**3-7*x**2-42*x)/(3*x+3)","respuesta_texto":"(x−2−4/(x+1))·(x+4x/3).","conjunto":"R","seccion":"Uso de signos de agrupación","unidad":6,"pagina_pdf":172,"referencia":"Actividad 205","apto_para":["practica","procedimiento_abierto"],"dificultad":600},
  {"id":"CS8-U6-P172-A206","tipo":"simbolico","enunciado":"Introduce signos de agrupación en (a²+3a)/(1−a²) ÷ (1−a)/(a+1) + a/(a−1) para obtener (a²+3a)/(1−3a).","expr":"((a**2+3*a)/(1-a**2))/((1-a)/(a+1)+a/(a-1))","respuesta":"(a**2+3*a)/(1-3*a)","respuesta_texto":"(a²+3a)/(1−a²) ÷ [(1−a)/(a+1)+a/(a−1)].","conjunto":"R","seccion":"Uso de signos de agrupación","unidad":6,"pagina_pdf":172,"referencia":"Actividad 206","apto_para":["practica","procedimiento_abierto"],"dificultad":650},
  {"id":"CS8-U6-P172-A207","tipo":"simbolico","enunciado":"Introduce signos de agrupación en 1/(a+4)+1/(a−4)·a/4−4/a para obtener 1/2.","expr":"(1/(a+4)+1/(a-4))*(a/4-4/a)","respuesta":"1/2","respuesta_texto":"[1/(a+4)+1/(a−4)]·(a/4−4/a).","conjunto":"R","seccion":"Uso de signos de agrupación","unidad":6,"pagina_pdf":172,"referencia":"Actividad 207","apto_para":["practica","procedimiento_abierto"],"dificultad":600},
  {"id":"CS8-U6-P172-A208","tipo":"simbolico","enunciado":"Resuelve [3ab/(5c⁵) · 6b/(4a²c)] ÷ [4a⁵/b³].","expr":"(3*a*b/(5*c**5)*6*b/(4*a**2*c))/(4*a**5/b**3)","respuesta":"9*b**5/(40*a**6*c**6)","conjunto":"R","seccion":"Operaciones combinadas","unidad":6,"pagina_pdf":172,"referencia":"Actividad 208","apto_para":["practica","procedimiento_abierto"],"dificultad":600},
  {"id":"CS8-U6-P172-A209","tipo":"simbolico","enunciado":"Resuelve 4x/(x+1) ÷ [3x⁴/(x²−1)] · (x²+2x)/(8x).","expr":"4*x/(x+1)/(3*x**4/(x**2-1))*(x**2+2*x)/(8*x)","respuesta":"(x-1)*(x+2)/(6*x**3)","conjunto":"R","seccion":"Operaciones combinadas","unidad":6,"pagina_pdf":172,"referencia":"Actividad 209","apto_para":["practica","procedimiento_abierto"],"dificultad":600},
  {"id":"CS8-U6-P172-A210","tipo":"simbolico","enunciado":"Resuelve [(n+1)/(n−1) · (3n−3)/(2n+2)] ÷ [(n²+n)/(n²−mn−2)].","expr":"((n+1)/(n-1)*(3*n-3)/(2*n+2))/((n**2+n)/(n**2-m*n-2))","respuesta":"3*(n**2-m*n-2)/(2*n*(n+1))","conjunto":"R","seccion":"Operaciones combinadas","unidad":6,"pagina_pdf":172,"referencia":"Actividad 210","apto_para":["practica","procedimiento_abierto"],"verificar":"La ampliación confirma que el denominador impreso es n²−mn−2, con dos variables, y no n²−n−2.","dificultad":650},
  {"id":"CS8-U6-P172-A211","tipo":"simbolico","enunciado":"Resuelve (x²−x−6)/(4x+8) · [5/(x²−5x+6) ÷ 3/(x²−4x+4)].","expr":"(x**2-x-6)/(4*x+8)*(5/(x**2-5*x+6)/(3/(x**2-4*x+4)))","respuesta":"5*(x-2)/12","conjunto":"R","seccion":"Operaciones combinadas","unidad":6,"pagina_pdf":172,"referencia":"Actividad 211","apto_para":["practica","procedimiento_abierto"],"dificultad":650},
  {"id":"CS8-U6-P172-A212","tipo":"simbolico","enunciado":"Resuelve (n+m)/(n²+2mn+m²) + (n+m)/(n−m) · (n−m)/(n+m).","expr":"(n+m)/(n**2+2*m*n+m**2)+(n+m)/(n-m)*(n-m)/(n+m)","respuesta":"(m+n+1)/(m+n)","conjunto":"R","seccion":"Operaciones combinadas","unidad":6,"pagina_pdf":172,"referencia":"Actividad 212","apto_para":["practica","procedimiento_abierto"],"dificultad":550},
  {"id":"CS8-U6-P172-A213","tipo":"simbolico","enunciado":"Resuelve (a−6−10/(a+3)) ÷ (a+2−2/(a+3)).","expr":"(a-6-10/(a+3))/(a+2-2/(a+3))","respuesta":"(a-7)/(a+1)","conjunto":"R","seccion":"Operaciones combinadas","unidad":6,"pagina_pdf":172,"referencia":"Actividad 213","apto_para":["practica","procedimiento_abierto"],"dificultad":600},
  {"id":"CS8-U6-P172-A214","tipo":"simbolico","enunciado":"Relaciona (x²−2x−3)/(x²+x−6) · [x/(x−3)−6/(x²−2x−3)] con su resultado.","expr":"(x**2-2*x-3)/(x**2+x-6)*(x/(x-3)-6/(x**2-2*x-3))","respuesta":"1","respuesta_texto":"Opción b: 1.","conjunto":"R","seccion":"Resultados de operaciones combinadas","unidad":6,"pagina_pdf":172,"referencia":"Actividad 214","apto_para":["practica","procedimiento_abierto"],"dificultad":650},
  {"id":"CS8-U6-P172-A215","tipo":"simbolico","enunciado":"Relaciona (x²−1)/(5x²+7x−6) ÷ [x/(5x−3)−1/(x+2)] con su resultado.","expr":"(x**2-1)/(5*x**2+7*x-6)/(x/(5*x-3)-1/(x+2))","respuesta":"(x**2-1)/(x**2-3*x+3)","respuesta_texto":"Opción a: (x²−1)/(x²−3x+3).","conjunto":"R","seccion":"Resultados de operaciones combinadas","unidad":6,"pagina_pdf":172,"referencia":"Actividad 215","apto_para":["practica","procedimiento_abierto"],"dificultad":650},
  {"id":"CS8-U6-P172-A216","tipo":"simbolico","enunciado":"Relaciona [x/(x+4)+(6x+6)/(x²+3x−4)] · (x²+3x−4)/(x²+4x+3) con su resultado.","expr":"(x/(x+4)+(6*x+6)/(x**2+3*x-4))*(x**2+3*x-4)/(x**2+4*x+3)","respuesta":"(x+2)/(x+1)","respuesta_texto":"Opción d: (x+2)/(x+1).","conjunto":"R","seccion":"Resultados de operaciones combinadas","unidad":6,"pagina_pdf":172,"referencia":"Actividad 216","apto_para":["practica","procedimiento_abierto"],"dificultad":650},
  {"id":"CS8-U6-P172-A217","tipo":"simbolico","enunciado":"Relaciona (2x²−3x−2)/(2x−x²+3) · [x/(2x+1)+1/(x−2)−(2x+4)/(2x²−3x−2)] con su resultado.","expr":"(2*x**2-3*x-2)/(2*x-x**2+3)*(x/(2*x+1)+1/(x-2)-(2*x+4)/(2*x**2-3*x-2))","respuesta":"-1","respuesta_texto":"Opción c: −1.","conjunto":"R","seccion":"Resultados de operaciones combinadas","unidad":6,"pagina_pdf":172,"referencia":"Actividad 217","apto_para":["practica","procedimiento_abierto"],"dificultad":700},
  {"id":"CS8-U6-P172-A218","tipo":"valores_numericos","enunciado":"Una lavadora es un prisma rectangular con dimensiones (x²+2x−8)/(πx+2π), (x+4)/(x²+4x+4) y (πx+2π)/(x²−16); su tanque cilíndrico tiene la misma altura y radio 2/(x²−16). Halla ambos volúmenes.","exprs":{"tanque":"pi*(2/(x**2-16))**2*((x**2+2*x-8)/(pi*x+2*pi))","lavadora":"((x**2+2*x-8)/(pi*x+2*pi))*((x+4)/(x**2+4*x+4))*((pi*x+2*pi)/(x**2-16))"},"respuesta_valores":{"tanque":"4*(x-2)/((x-4)**2*(x+2)*(x+4))","lavadora":"(x-2)*(x+4)/((x-4)*(x+2)**2)"},"respuesta":"Tanque: 4(x−2)/[(x−4)²(x+2)(x+4)]. Lavadora: (x−2)(x+4)/[(x−4)(x+2)²].","conjunto":"R","seccion":"Volúmenes con operaciones combinadas","unidad":6,"pagina_pdf":172,"referencia":"Actividad 218","apto_para":["practica","procedimiento_abierto"],"verificar":"Las dimensiones del prisma, la altura común y el radio se transcribieron de la figura de la lavadora.","dificultad":700},
  {"id":"CS8-U6-P172-A219","tipo":"simbolico","enunciado":"Determina la diferencia entre el volumen de la lavadora y el del tanque cilíndrico de la actividad 218.","expr":"((x**2+2*x-8)/(pi*x+2*pi))*((x+4)/(x**2+4*x+4))*((pi*x+2*pi)/(x**2-16))-pi*(2/(x**2-16))**2*((x**2+2*x-8)/(pi*x+2*pi))","respuesta":"(x-2)*(x**3+4*x**2-20*x-72)/((x-4)**2*(x+2)**2*(x+4))","respuesta_texto":"Se tomó la diferencia dirigida V_lavadora−V_tanque; para la interpretación física usual x>4 es positiva.","conjunto":"R","seccion":"Volúmenes con operaciones combinadas","unidad":6,"pagina_pdf":172,"referencia":"Actividad 219","apto_para":["practica","procedimiento_abierto"],"restricciones":["x>4"],"verificar":"La consigna no explicita el orden de la resta; se registró volumen exterior menos volumen del tanque.","dificultad":750}
]
