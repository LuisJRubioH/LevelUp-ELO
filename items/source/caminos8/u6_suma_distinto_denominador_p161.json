[
  {"id":"CS8-U6-P161-A133","tipo":"simbolico","enunciado":"Relaciona 1/x + 1/y con su resultado.","expr":"1/x+1/y","respuesta":"(x+y)/(x*y)","respuesta_texto":"Opción d: (y+x)/(xy).","conjunto":"R","seccion":"Suma de fracciones con distinto denominador","unidad":6,"pagina_pdf":161,"referencia":"Actividad 133","apto_para":["practica","procedimiento_abierto"],"dificultad":400},
  {"id":"CS8-U6-P161-A134","tipo":"simbolico","enunciado":"Relaciona x/(x-y) + y/(x-y) con su resultado.","expr":"x/(x-y)+y/(x-y)","respuesta":"(x+y)/(x-y)","respuesta_texto":"Opción a: (x+y)/(x-y).","conjunto":"R","seccion":"Suma de fracciones con distinto denominador","unidad":6,"pagina_pdf":161,"referencia":"Actividad 134","apto_para":["practica","procedimiento_abierto"],"dificultad":400},
  {"id":"CS8-U6-P161-A135","tipo":"simbolico","enunciado":"Relaciona x + 1/y con su resultado.","expr":"x+1/y","respuesta":"(x*y+1)/y","respuesta_texto":"Opción b: (xy+1)/y.","conjunto":"R","seccion":"Suma de fracciones con distinto denominador","unidad":6,"pagina_pdf":161,"referencia":"Actividad 135","apto_para":["practica","procedimiento_abierto"],"dificultad":400},
  {"id":"CS8-U6-P161-A136","tipo":"simbolico","enunciado":"Relaciona x/y + 1 con su resultado.","expr":"x/y+1","respuesta":"(x+y)/y","respuesta_texto":"Opción c: (x+y)/y.","conjunto":"R","seccion":"Suma de fracciones con distinto denominador","unidad":6,"pagina_pdf":161,"referencia":"Actividad 136","apto_para":["practica","procedimiento_abierto"],"dificultad":400},
  {"id":"CS8-U6-P161-A137","tipo":"simbolico","enunciado":"Resuelve 5n/(4m) + 3/(2m²).","expr":"5*n/(4*m)+3/(2*m**2)","respuesta":"(5*m*n+6)/(4*m**2)","conjunto":"R","seccion":"Operaciones con distinto denominador","unidad":6,"pagina_pdf":161,"referencia":"Actividad 137","apto_para":["practica","procedimiento_abierto"],"dificultad":450},
  {"id":"CS8-U6-P161-A138","tipo":"simbolico","enunciado":"Resuelve (x+y)/(2x²) + (5-x)/(6x) + (y-7)/(20x³).","expr":"(x+y)/(2*x**2)+(5-x)/(6*x)+(y-7)/(20*x**3)","respuesta":"(-10*x**3+80*x**2+30*x*y+3*y-21)/(60*x**3)","conjunto":"R","seccion":"Operaciones con distinto denominador","unidad":6,"pagina_pdf":161,"referencia":"Actividad 138","apto_para":["practica","procedimiento_abierto"],"dificultad":600},
  {"id":"CS8-U6-P161-A139","tipo":"simbolico","enunciado":"Resuelve (n+m)/(n²-nm) + (n+m)/(nm+m²).","expr":"(n+m)/(n**2-n*m)+(n+m)/(n*m+m**2)","respuesta":"(m**2+n**2)/(m*n*(n-m))","conjunto":"R","seccion":"Operaciones con distinto denominador","unidad":6,"pagina_pdf":161,"referencia":"Actividad 139","apto_para":["practica","procedimiento_abierto"],"dificultad":600},
  {"id":"CS8-U6-P161-A140","tipo":"simbolico","enunciado":"Resuelve 1/(a+a²) + 3/(a-a²) + (8+a)/(1-a²).","expr":"1/(a+a**2)+3/(a-a**2)+(8+a)/(1-a**2)","respuesta":"-(a**2+10*a+4)/(a*(a-1)*(a+1))","conjunto":"R","seccion":"Operaciones con distinto denominador","unidad":6,"pagina_pdf":161,"referencia":"Actividad 140","apto_para":["practica","procedimiento_abierto"],"dificultad":650},
  {"id":"CS8-U6-P161-A141","tipo":"simbolico","enunciado":"Resuelve 2/(m-5) + (1-m)/(m²-1) + (12-m²)/(m³-5m²-m+5).","expr":"2/(m-5)+(1-m)/(m**2-1)+(12-m**2)/(m**3-5*m**2-m+5)","respuesta":"(6*m+5)/((m-5)*(m-1)*(m+1))","conjunto":"R","seccion":"Operaciones con distinto denominador","unidad":6,"pagina_pdf":161,"referencia":"Actividad 141","apto_para":["practica","procedimiento_abierto"],"dificultad":700},
  {"id":"CS8-U6-P161-A142","tipo":"simbolico","enunciado":"Resuelve 2x/(x²+3x+2) + (x+4)/(x²-4) + (2x-3)/(x²-x-2).","expr":"2*x/(x**2+3*x+2)+(x+4)/(x**2-4)+(2*x-3)/(x**2-x-2)","respuesta":"(5*x**2+2*x-2)/((x-2)*(x+1)*(x+2))","conjunto":"R","seccion":"Operaciones con distinto denominador","unidad":6,"pagina_pdf":161,"referencia":"Actividad 142","apto_para":["practica","procedimiento_abierto"],"dificultad":700},
  {"id":"CS8-U6-P161-A143","tipo":"simbolico","enunciado":"Indica si (x-1)/(x²+x) - 1/(2x+2) - 1/(2x-2) = (1+2x)/[x(1-x²)].","expr":"(x-1)/(x**2+x)-1/(2*x+2)-1/(2*x-2)","afirmacion":"(1+2*x)/(x*(1-x**2))","veredicto":"F","respuesta":"-(2*x-1)/(x*(x-1)*(x+1))","respuesta_texto":"Falso; el resultado correcto es -(2x-1)/[x(x-1)(x+1)].","conjunto":"R","seccion":"Verificación y corrección de operaciones","unidad":6,"pagina_pdf":161,"referencia":"Actividad 143","apto_para":["practica","procedimiento_abierto"],"dificultad":650},
  {"id":"CS8-U6-P161-A144","tipo":"simbolico","enunciado":"Indica si x/(x²-y²) - y/(x²+xy) = y²/[x(x²-y²)].","expr":"x/(x**2-y**2)-y/(x**2+x*y)","afirmacion":"y**2/(x*(x**2-y**2))","veredicto":"F","respuesta":"(x**2-x*y+y**2)/(x*(x-y)*(x+y))","respuesta_texto":"Falso; el resultado correcto es (x²-xy+y²)/[x(x-y)(x+y)].","conjunto":"R","seccion":"Verificación y corrección de operaciones","unidad":6,"pagina_pdf":161,"referencia":"Actividad 144","apto_para":["practica","procedimiento_abierto"],"dificultad":650},
  {"id":"CS8-U6-P161-A145","tipo":"simbolico","enunciado":"Indica si a/(a²-ab) - 1/a - 1/(b-a) = 2/(b-a).","expr":"a/(a**2-a*b)-1/a-1/(b-a)","afirmacion":"2/(b-a)","veredicto":"F","respuesta":"(a+b)/(a*(a-b))","respuesta_texto":"Falso; el resultado correcto es (a+b)/[a(a-b)].","conjunto":"R","seccion":"Verificación y corrección de operaciones","unidad":6,"pagina_pdf":161,"referencia":"Actividad 145","apto_para":["practica","procedimiento_abierto"],"dificultad":600},
  {"id":"CS8-U6-P161-A146","tipo":"simbolico","enunciado":"Indica si (2x-1)/(x²+5x-6) - (3+x)/(x²+2x-3) = (x-1)/[(x+5)(x-2)].","expr":"(2*x-1)/(x**2+5*x-6)-(3+x)/(x**2+2*x-3)","afirmacion":"(x-1)/((x+5)*(x-2))","veredicto":"F","respuesta":"(x-7)/((x-1)*(x+6))","respuesta_texto":"Falso; el resultado correcto es (x-7)/[(x-1)(x+6)].","conjunto":"R","seccion":"Verificación y corrección de operaciones","unidad":6,"pagina_pdf":161,"referencia":"Actividad 146","apto_para":["practica","procedimiento_abierto"],"dificultad":650},
  {"id":"CS8-U6-P161-A147","tipo":"simbolico","enunciado":"Indica si 1/(n-3m) - (n²+9m²)/(n³-27m³) - n/(n²+3mn+9m²) = n/m.","expr":"1/(n-3*m)-(n**2+9*m**2)/(n**3-27*m**3)-n/(n**2+3*m*n+9*m**2)","afirmacion":"n/m","veredicto":"F","respuesta":"-n*(6*m-n)/((3*m-n)*(9*m**2+3*m*n+n**2))","respuesta_texto":"Falso; el resultado correcto es -n(6m-n)/[(3m-n)(9m²+3mn+n²)].","conjunto":"R","seccion":"Verificación y corrección de operaciones","unidad":6,"pagina_pdf":161,"referencia":"Actividad 147","apto_para":["practica","procedimiento_abierto"],"dificultad":750},
  {"id":"CS8-U6-P161-A148","tipo":"simbolico","enunciado":"Indica si (2n-3)/(10n+10) - (1+n)/(50n) - (11n²-15n-1)/(50n²+50n) = -1/25.","expr":"(2*n-3)/(10*n+10)-(1+n)/(50*n)-(11*n**2-15*n-1)/(50*n**2+50*n)","afirmacion":"-1/25","veredicto":"V","respuesta":"-1/25","respuesta_texto":"Verdadero.","conjunto":"R","seccion":"Verificación y corrección de operaciones","unidad":6,"pagina_pdf":161,"referencia":"Actividad 148","apto_para":["practica","procedimiento_abierto"],"dificultad":700},
  {"id":"CS8-U6-P161-A149","tipo":"simbolico","enunciado":"Si (xy-2)/(5x²y) es la diferencia y (4x-1)/(15x²y²) es el minuendo, determina el sustraendo.","expr":"(4*x-1)/(15*x**2*y**2)-(x*y-2)/(5*x**2*y)","respuesta":"-(3*x*y**2-4*x-6*y+1)/(15*x**2*y**2)","conjunto":"R","seccion":"Planteamiento de expresiones algebraicas","unidad":6,"pagina_pdf":161,"referencia":"Actividad 149","apto_para":["practica","procedimiento_abierto"],"dificultad":650},
  {"id":"CS8-U6-P161-A150","tipo":"simbolico","enunciado":"¿Qué fracción algebraica sumada con 2x/(x+3) da como resultado (x-2)/(x-3)?","expr":"(x-2)/(x-3)-2*x/(x+3)","respuesta":"-(x-6)*(x-1)/((x-3)*(x+3))","conjunto":"R","seccion":"Planteamiento de expresiones algebraicas","unidad":6,"pagina_pdf":161,"referencia":"Actividad 150","apto_para":["practica","procedimiento_abierto"],"dificultad":600},
  {"id":"CS8-U6-P161-A151","tipo":"simbolico","enunciado":"¿Qué expresión se debe restar de (3m+2n)/(2m-n) para que la diferencia sea (2m+3n)/(4m²+2mn+n²)?","expr":"(3*m+2*n)/(2*m-n)-(2*m+3*n)/(4*m**2+2*m*n+n**2)","respuesta":"(12*m**3+14*m**2*n-4*m**2+7*m*n**2-4*m*n+2*n**3+3*n**2)/((2*m-n)*(4*m**2+2*m*n+n**2))","conjunto":"R","seccion":"Planteamiento de expresiones algebraicas","unidad":6,"pagina_pdf":161,"referencia":"Actividad 151","apto_para":["practica","procedimiento_abierto"],"dificultad":700},
  {"id":"CS8-U6-P161-A152","tipo":"abierta","enunciado":"Cada cubo azul vale 1/x, cada rojo 1/x² y cada amarillo x/(x+1). Escribe la expresión del grupo 152.","respuesta":"3/x + 1/x² + 5x/(x+1).","conjunto":"R","seccion":"Modelación visual con fracciones algebraicas","unidad":6,"pagina_pdf":161,"referencia":"Actividad 152","apto_para":["procedimiento_abierto"],"verificar":"Conteo visual en la figura: 3 cubos azules, 1 rojo y 5 amarillos.","dificultad":450},
  {"id":"CS8-U6-P161-A153","tipo":"abierta","enunciado":"Cada cubo azul vale 1/x, cada rojo 1/x² y cada amarillo x/(x+1). Escribe la expresión del grupo 153.","respuesta":"6/x + 4/x² + 3x/(x+1).","conjunto":"R","seccion":"Modelación visual con fracciones algebraicas","unidad":6,"pagina_pdf":161,"referencia":"Actividad 153","apto_para":["procedimiento_abierto"],"verificar":"Conteo visual en la figura: 6 cubos azules, 4 rojos y 3 amarillos.","dificultad":450},
  {"id":"CS8-U6-P161-A154","tipo":"abierta","enunciado":"Cada cubo azul vale 1/x, cada rojo 1/x² y cada amarillo x/(x+1). Escribe la expresión del grupo 154.","respuesta":"1/x + 1/x² + x/(x+1).","conjunto":"R","seccion":"Modelación visual con fracciones algebraicas","unidad":6,"pagina_pdf":161,"referencia":"Actividad 154","apto_para":["procedimiento_abierto"],"verificar":"Conteo visual en la figura: un cubo de cada color.","dificultad":400},
  {"id":"CS8-U6-P161-A155","tipo":"abierta","enunciado":"Cada cubo azul vale 1/x, cada rojo 1/x² y cada amarillo x/(x+1). Escribe la expresión del grupo 155.","respuesta":"3/x + 5x/(x+1).","conjunto":"R","seccion":"Modelación visual con fracciones algebraicas","unidad":6,"pagina_pdf":161,"referencia":"Actividad 155","apto_para":["procedimiento_abierto"],"verificar":"Conteo visual en la figura: 3 cubos azules y 5 amarillos.","dificultad":400},
  {"id":"CS8-U6-P161-A156","tipo":"abierta","enunciado":"Cada cubo azul vale 1/x, cada rojo 1/x² y cada amarillo x/(x+1). Escribe la expresión del grupo 156.","respuesta":"8/x + 8/x² + 2x/(x+1).","conjunto":"R","seccion":"Modelación visual con fracciones algebraicas","unidad":6,"pagina_pdf":161,"referencia":"Actividad 156","apto_para":["procedimiento_abierto"],"verificar":"Conteo visual de la figura compleja: 8 cubos azules, 8 rojos y 2 amarillos; varias caras quedan parcialmente ocultas.","dificultad":500},
  {"id":"CS8-U6-P161-A157","tipo":"simbolico","enunciado":"Un terreno rectangular tiene largo b m y área a m². Compara el ancho si se aumenta el área en 1 m² sin cambiar el largo, con el ancho si se aumenta el largo en 1 m sin cambiar el área.","expr":"(a+1)/b-a/(b+1)","respuesta":"(a+b+1)/(b*(b+1))","respuesta_texto":"El primer ancho, (a+1)/b, es mayor que a/(b+1), porque su diferencia es (a+b+1)/[b(b+1)]>0 para a,b>0.","conjunto":"R","seccion":"Aplicación de fracciones algebraicas","unidad":6,"pagina_pdf":161,"referencia":"Actividad 157","apto_para":["practica","procedimiento_abierto"],"restricciones":["a>0","b>0"],"dificultad":600}
]
