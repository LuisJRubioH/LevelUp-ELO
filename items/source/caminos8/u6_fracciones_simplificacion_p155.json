  {"id":"CS8-U6-P155-A69","tipo":"abierta","enunciado":"Organiza las fichas para definir una fracción algebraica.","respuesta":"Fracción algebraica es el cociente de dos polinomios escrito en forma de fracción, donde en el denominador aparecen una o más variables.","conjunto":"R","seccion":"Fracciones algebraicas","unidad":6,"pagina_pdf":155,"referencia":"Actividad 69","apto_para":["procedimiento_abierto"],"dificultad":350},
  {"id":"CS8-U6-P155-A70","tipo":"abierta","enunciado":"Escribe una fracción algebraica cuyo numerador sea un monomio.","respuesta":"Ejemplo: 3x²/(x+1).","conjunto":"R","seccion":"Construcción de fracciones algebraicas","unidad":6,"pagina_pdf":155,"referencia":"Actividad 70","apto_para":["procedimiento_abierto"],"dificultad":350},
  {"id":"CS8-U6-P155-A71","tipo":"abierta","enunciado":"Escribe una fracción algebraica cuyo numerador y denominador sean binomios.","respuesta":"Ejemplo: (x+2)/(x-3).","conjunto":"R","seccion":"Construcción de fracciones algebraicas","unidad":6,"pagina_pdf":155,"referencia":"Actividad 71","apto_para":["procedimiento_abierto"],"dificultad":350},
  {"id":"CS8-U6-P155-A72","tipo":"abierta","enunciado":"Escribe una fracción algebraica cuyo denominador tenga un término más que el numerador.","respuesta":"Ejemplo: (x+1)/(x²+x+1).","conjunto":"R","seccion":"Construcción de fracciones algebraicas","unidad":6,"pagina_pdf":155,"referencia":"Actividad 72","apto_para":["procedimiento_abierto"],"dificultad":400},
  {"id":"CS8-U6-P155-A73","tipo":"simbolico","enunciado":"Amplifica (5-x)/(x+4) por x²/x².","expr":"(5-x)/(x+4)","respuesta":"x**2*(5-x)/(x**2*(x+4))","conjunto":"R","seccion":"Amplificación de fracciones algebraicas","unidad":6,"pagina_pdf":155,"referencia":"Actividad 73","apto_para":["practica","procedimiento_abierto"],"dificultad":400},
  {"id":"CS8-U6-P155-A74","tipo":"simbolico","enunciado":"Amplifica a/(a+4) por 5a³/5a³.","expr":"a/(a+4)","respuesta":"5*a**4/(5*a**3*(a+4))","conjunto":"R","seccion":"Amplificación de fracciones algebraicas","unidad":6,"pagina_pdf":155,"referencia":"Actividad 74","apto_para":["practica","procedimiento_abierto"],"dificultad":400},
  {"id":"CS8-U6-P155-A75","tipo":"simbolico","enunciado":"Amplifica (y-3)/(y+4) por (y-1)/(y-1).","expr":"(y-3)/(y+4)","respuesta":"(y-3)*(y-1)/((y+4)*(y-1))","conjunto":"R","seccion":"Amplificación de fracciones algebraicas","unidad":6,"pagina_pdf":155,"referencia":"Actividad 75","apto_para":["practica","procedimiento_abierto"],"dificultad":400},
  {"id":"CS8-U6-P155-A76","tipo":"simbolico","enunciado":"Amplifica (4x²-y)/(x²-3y) por (x+y)/(x+y).","expr":"(4*x**2-y)/(x**2-3*y)","respuesta":"(4*x**2-y)*(x+y)/((x**2-3*y)*(x+y))","conjunto":"R","seccion":"Amplificación de fracciones algebraicas","unidad":6,"pagina_pdf":155,"referencia":"Actividad 76","apto_para":["practica","procedimiento_abierto"],"dificultad":450},
  {"id":"CS8-U6-P155-A77","tipo":"simbolico","enunciado":"Amplifica (x²+x+1)/(x+4) por (x-1)/(x-1).","expr":"(x**2+x+1)/(x+4)","respuesta":"(x**2+x+1)*(x-1)/((x+4)*(x-1))","conjunto":"R","seccion":"Amplificación de fracciones algebraicas","unidad":6,"pagina_pdf":155,"referencia":"Actividad 77","apto_para":["practica","procedimiento_abierto"],"dificultad":450},
  {"id":"CS8-U6-P155-A78","tipo":"simbolico","enunciado":"Determina si cambiar el signo de una fracción equivale a multiplicar y dividir la fracción por -1.","expr":"-u","afirmacion":"(-u)/(-1)","veredicto":"F","respuesta":"-u","respuesta_texto":"Falso: multiplicar numerador y denominador por -1 conserva la fracción; para cambiar su signo se cambia solo uno de ellos.","conjunto":"R","seccion":"Equivalencia de fracciones algebraicas","unidad":6,"pagina_pdf":155,"referencia":"Actividad 78","apto_para":["practica","procedimiento_abierto"],"dificultad":450},
  {"id":"CS8-U6-P155-A79","tipo":"simbolico","enunciado":"Determina si al simplificar (x⁵+x²)/x³ se obtiene x³.","expr":"(x**5+x**2)/x**3","afirmacion":"x**3","veredicto":"F","respuesta":"x**2+1/x","conjunto":"R","seccion":"Simplificación de fracciones algebraicas","unidad":6,"pagina_pdf":155,"referencia":"Actividad 79","apto_para":["practica","procedimiento_abierto"],"dificultad":450},
  {"id":"CS8-U6-P155-A80","tipo":"simbolico","enunciado":"Determina si (3-2x)/x² es equivalente a (2x-3)/x².","expr":"(3-2*x)/x**2","afirmacion":"(2*x-3)/x**2","veredicto":"F","respuesta":"-(2*x-3)/x**2","conjunto":"R","seccion":"Equivalencia de fracciones algebraicas","unidad":6,"pagina_pdf":155,"referencia":"Actividad 80","apto_para":["practica","procedimiento_abierto"],"dificultad":400},
  {"id":"CS8-U6-P155-A81","tipo":"simbolico","enunciado":"Determina si la expresión simplificada de (9-x²)/(3-x) es 3-x.","expr":"(9-x**2)/(3-x)","afirmacion":"3-x","veredicto":"F","respuesta":"x+3","conjunto":"R","seccion":"Simplificación de fracciones algebraicas","unidad":6,"pagina_pdf":155,"referencia":"Actividad 81","apto_para":["practica","procedimiento_abierto"],"dificultad":450},
