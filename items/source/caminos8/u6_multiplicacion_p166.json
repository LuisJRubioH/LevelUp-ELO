[
  {"id":"CS8-U6-P166-A166","tipo":"simbolico","enunciado":"Organiza la multiplicación con 9a⁵y/(13x), 18a²x³/y² y 26x⁴/(a³y³), identificando producto y factores.","expr":"9*a**5*y/(13*x)*26*x**4/(a**3*y**3)","respuesta":"18*a**2*x**3/y**2","respuesta_texto":"9a⁵y/(13x) · 26x⁴/(a³y³) = 18a²x³/y².","conjunto":"R","seccion":"Multiplicación de fracciones algebraicas","unidad":6,"pagina_pdf":166,"referencia":"Actividad 166","apto_para":["practica","procedimiento_abierto"],"dificultad":500},
  {"id":"CS8-U6-P166-A167","tipo":"simbolico","enunciado":"Organiza la multiplicación con 4/n, 32m³/(5n⁴), 5mn y n²/(8m⁴), identificando producto y factores.","expr":"32*m**3/(5*n**4)*5*m*n*n**2/(8*m**4)","respuesta":"4/n","respuesta_texto":"32m³/(5n⁴) · 5mn · n²/(8m⁴) = 4/n.","conjunto":"R","seccion":"Multiplicación de fracciones algebraicas","unidad":6,"pagina_pdf":166,"referencia":"Actividad 167","apto_para":["practica","procedimiento_abierto"],"dificultad":500},
  {"id":"CS8-U6-P166-A168","tipo":"simbolico","enunciado":"Organiza la multiplicación con 2c³/(15d³), 5c²/(7cn²), 2c⁴/(7dn³) y 3d²/n, identificando producto y factores.","expr":"2*c**3/(15*d**3)*5*c**2/(7*c*n**2)*3*d**2/n","respuesta":"2*c**4/(7*d*n**3)","respuesta_texto":"2c³/(15d³) · 5c²/(7cn²) · 3d²/n = 2c⁴/(7dn³).","conjunto":"R","seccion":"Multiplicación de fracciones algebraicas","unidad":6,"pagina_pdf":166,"referencia":"Actividad 168","apto_para":["practica","procedimiento_abierto"],"dificultad":550},
  {"id":"CS8-U6-P166-A169","tipo":"simbolico","enunciado":"Organiza la multiplicación con (x²−4)/(x−3), (x+3)/(x−5), (x²−9)/(x²−4x+4) y (x−2)/(x²−3x−10).","expr":"(x**2-4)/(x-3)*(x**2-9)/(x**2-4*x+4)*(x-2)/(x**2-3*x-10)","respuesta":"(x+3)/(x-5)","respuesta_texto":"(x²−4)/(x−3) · (x²−9)/(x²−4x+4) · (x−2)/(x²−3x−10) = (x+3)/(x−5).","conjunto":"R","seccion":"Multiplicación de fracciones algebraicas","unidad":6,"pagina_pdf":166,"referencia":"Actividad 169","apto_para":["practica","procedimiento_abierto"],"dificultad":650},
  {"id":"CS8-U6-P166-A170","tipo":"abierta","enunciado":"Completa una pirámide multiplicativa de tres niveles cuya base comienza con A=4m²/(3n) y B=2n³/(5m); cada casilla superior es el producto de las dos inferiores consecutivas.","respuesta":"Una solución válida es tomar la tercera casilla de la base igual a 1. La segunda fila queda 8mn²/15 y 2n³/(5m), y la cima queda 16n⁵/75.","conjunto":"R","seccion":"Pirámides multiplicativas","unidad":6,"pagina_pdf":166,"referencia":"Actividad 170","apto_para":["procedimiento_abierto"],"verificar":"La tercera fracción de la base no está fijada; existen infinitas pirámides correctas. Evaluar la regla de productos, no exigir este ejemplo exacto.","dificultad":500},
  {"id":"CS8-U6-P166-A171","tipo":"abierta","enunciado":"Completa una pirámide multiplicativa de tres niveles con C=(x+4)/(x³+x²−x−1) en la primera casilla de la base y E=4/(x+1) en la tercera.","respuesta":"Una solución válida es tomar la casilla central igual a 1. La segunda fila queda C y E, y la cima es 4(x+4)/[(x−1)(x+1)³].","conjunto":"R","seccion":"Pirámides multiplicativas","unidad":6,"pagina_pdf":166,"referencia":"Actividad 171","apto_para":["procedimiento_abierto"],"verificar":"La fracción central de la base es libre; existen infinitas soluciones. La respuesta registrada usa 1 únicamente como ejemplo.","dificultad":550},
  {"id":"CS8-U6-P166-A172","tipo":"simbolico","enunciado":"Resuelve 3x²y/(5xy) · 4xy⁴/(6xy) · 90x²yz/(8xz³).","expr":"3*x**2*y/(5*x*y)*4*x*y**4/(6*x*y)*90*x**2*y*z/(8*x*z**3)","respuesta":"9*x**2*y**4/(2*z**2)","conjunto":"R","seccion":"Productos de fracciones algebraicas","unidad":6,"pagina_pdf":166,"referencia":"Actividad 172","apto_para":["practica","procedimiento_abierto"],"dificultad":550},
  {"id":"CS8-U6-P166-A173","tipo":"simbolico","enunciado":"Resuelve (x+2)/(x−1) · (x²−1)/(x²−4) · (x+4)/(x−2).","expr":"(x+2)/(x-1)*(x**2-1)/(x**2-4)*(x+4)/(x-2)","respuesta":"(x+1)*(x+4)/(x-2)**2","conjunto":"R","seccion":"Productos de fracciones algebraicas","unidad":6,"pagina_pdf":166,"referencia":"Actividad 173","apto_para":["practica","procedimiento_abierto"],"dificultad":550},
  {"id":"CS8-U6-P166-A174","tipo":"simbolico","enunciado":"Resuelve 9xy²/(4ab) · 7a²/(18xy) · 3b/(42y) · 2y/(ab).","expr":"9*x*y**2/(4*a*b)*7*a**2/(18*x*y)*3*b/(42*y)*2*y/(a*b)","respuesta":"y/(8*b)","conjunto":"R","seccion":"Productos de fracciones algebraicas","unidad":6,"pagina_pdf":166,"referencia":"Actividad 174","apto_para":["practica","procedimiento_abierto"],"dificultad":550},
  {"id":"CS8-U6-P166-A175","tipo":"simbolico","enunciado":"Resuelve (2x²+x)/(6x) · 8x³/(4x+2) · (x−3)/(12x).","expr":"(2*x**2+x)/(6*x)*8*x**3/(4*x+2)*(x-3)/(12*x)","respuesta":"x**2*(x-3)/18","conjunto":"R","seccion":"Productos de fracciones algebraicas","unidad":6,"pagina_pdf":166,"referencia":"Actividad 175","apto_para":["practica","procedimiento_abierto"],"dificultad":550},
  {"id":"CS8-U6-P166-A176","tipo":"simbolico","enunciado":"Resuelve (2x−2y)/(x²−y²) · (7x+7y)/(42x−42y) · (x−y)/x.","expr":"(2*x-2*y)/(x**2-y**2)*(7*x+7*y)/(42*x-42*y)*(x-y)/x","respuesta":"1/(3*x)","conjunto":"R","seccion":"Productos de fracciones algebraicas","unidad":6,"pagina_pdf":166,"referencia":"Actividad 176","apto_para":["practica","procedimiento_abierto"],"dificultad":600},
  {"id":"CS8-U6-P166-A177","tipo":"simbolico","enunciado":"Resuelve (3a³+3ab²)/(3ax²−3ax) · (x³−x)/(a²x+b²x) · x/(x+1).","expr":"(3*a**3+3*a*b**2)/(3*a*x**2-3*a*x)*(x**3-x)/(a**2*x+b**2*x)*x/(x+1)","respuesta":"1","conjunto":"R","seccion":"Productos de fracciones algebraicas","unidad":6,"pagina_pdf":166,"referencia":"Actividad 177","apto_para":["practica","procedimiento_abierto"],"dificultad":650},
  {"id":"CS8-U6-P166-A178","tipo":"simbolico","enunciado":"Resuelve (2ab+3b²)/(10b²+6ab−25b−15a) · (2b³−2a²b−5b²+5a²)/(2a²b+5ab²+3b³).","expr":"(2*a*b+3*b**2)/(10*b**2+6*a*b-25*b-15*a)*(2*b**3-2*a**2*b-5*b**2+5*a**2)/(2*a**2*b+5*a*b**2+3*b**3)","respuesta":"-(a-b)/(3*a+5*b)","conjunto":"R","seccion":"Productos de fracciones algebraicas","unidad":6,"pagina_pdf":166,"referencia":"Actividad 178","apto_para":["practica","procedimiento_abierto"],"dificultad":750},
  {"id":"CS8-U6-P166-A179","tipo":"simbolico","enunciado":"Resuelve (x²−9)/(x−3)² · (x²−7x+12)/(x²+8x+16) · (x+4)/(x²+3x).","expr":"(x**2-9)/(x-3)**2*(x**2-7*x+12)/(x**2+8*x+16)*(x+4)/(x**2+3*x)","respuesta":"(x-4)/(x*(x+4))","conjunto":"R","seccion":"Productos de fracciones algebraicas","unidad":6,"pagina_pdf":166,"referencia":"Actividad 179","apto_para":["practica","procedimiento_abierto"],"dificultad":650},
  {"id":"CS8-U6-P166-A180","tipo":"simbolico","enunciado":"Determina si (a²−25b²)/(a−3b) · (a²−7ab+12b²)/(a−5b) = a²−20b²; localiza el error si existe.","expr":"(a**2-25*b**2)/(a-3*b)*(a**2-7*a*b+12*b**2)/(a-5*b)","afirmacion":"a**2-20*b**2","veredicto":"F","respuesta":"(a-4*b)*(a+5*b)","respuesta_texto":"Falso: el producto es (a−4b)(a+5b)=a²+ab−20b²; en el resultado propuesto se perdió el término ab.","conjunto":"R","seccion":"Análisis de errores en productos","unidad":6,"pagina_pdf":166,"referencia":"Actividad 180","apto_para":["practica","procedimiento_abierto"],"dificultad":650},
  {"id":"CS8-U6-P166-A181","tipo":"simbolico","enunciado":"Determina si 2x/(x−2) · (x²−4)/(x²+x) · (x²−1)/(x+2) = x−2; localiza el error si existe.","expr":"2*x/(x-2)*(x**2-4)/(x**2+x)*(x**2-1)/(x+2)","afirmacion":"x-2","veredicto":"F","respuesta":"2*(x-1)","respuesta_texto":"Falso: el producto correcto es 2(x−1)=2x−2.","conjunto":"R","seccion":"Análisis de errores en productos","unidad":6,"pagina_pdf":166,"referencia":"Actividad 181","apto_para":["practica","procedimiento_abierto"],"dificultad":600},
  {"id":"CS8-U6-P166-A182","tipo":"simbolico","enunciado":"Halla el volumen del prisma rectangular con dimensiones (x²−81)/(2x²+10x), (x+11)/(x²−36) y (2x+12)/(2x+18).","expr":"(x**2-81)/(2*x**2+10*x)*(x+11)/(x**2-36)*(2*x+12)/(2*x+18)","respuesta":"(x-9)*(x+11)/(2*x*(x-6)*(x+5))","conjunto":"R","seccion":"Volúmenes con fracciones algebraicas","unidad":6,"pagina_pdf":166,"referencia":"Actividad 182","apto_para":["practica","procedimiento_abierto"],"verificar":"Las tres dimensiones y su asignación se leen en la figura del prisma.","dificultad":650},
  {"id":"CS8-U6-P166-A183","tipo":"simbolico","enunciado":"Halla el volumen de una pirámide rectangular con base de lados (16+2u²)/(2u²−4) y (u³−u)/(u³−1), y altura u/(u+1).","expr":"(1/3)*(16+2*u**2)/(2*u**2-4)*(u**3-u)/(u**3-1)*u/(u+1)","respuesta":"u**2*(u**2+8)/(3*(u**2-2)*(u**2+u+1))","conjunto":"R","seccion":"Volúmenes con fracciones algebraicas","unidad":6,"pagina_pdf":166,"referencia":"Actividad 183","apto_para":["practica","procedimiento_abierto"],"verificar":"Las dos dimensiones de la base y la altura se transcribieron de la figura de la pirámide.","dificultad":700},
  {"id":"CS8-U6-P166-A184","tipo":"simbolico","enunciado":"Halla el volumen del prisma rectangular con dimensiones y/(y²+y+1), (y²−1)/(2y) y (y³−1)/(2y).","expr":"y/(y**2+y+1)*(y**2-1)/(2*y)*(y**3-1)/(2*y)","respuesta":"(y-1)**2*(y+1)/(4*y)","conjunto":"R","seccion":"Volúmenes con fracciones algebraicas","unidad":6,"pagina_pdf":166,"referencia":"Actividad 184","apto_para":["practica","procedimiento_abierto"],"verificar":"Las tres dimensiones se transcribieron de la figura del prisma.","dificultad":650}
]
