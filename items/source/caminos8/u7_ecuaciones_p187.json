  {"id":"CS8-U7-P187-A01D","tipo":"elementos_ecuacion","enunciado":"Completa la tabla para 12y−3=5y: identifica primer miembro, segundo miembro e incógnita.","ecuacion":"12*y-3=5*y","primer_miembro":"12*y-3","segundo_miembro":"5*y","incognita":"y","respuesta":"Primer miembro: 12y−3; segundo miembro: 5y; incógnita: y.","conjunto":"R","seccion":"Elementos de una ecuación","unidad":7,"pagina_pdf":187,"referencia":"Actividad 1, fila 4","apto_para":["procedimiento_abierto"],"dificultad":300},
  {"id":"CS8-U7-P187-A02","tipo":"ecuacion","enunciado":"Representa con una ecuación la balanza en equilibrio que tiene 6 en el plato izquierdo y x junto con 2 en el derecho.","ecuacion":"6=x+2","incognita":"x","soluciones":["4"],"respuesta":"6=x+2; por tanto, x=4.","conjunto":"R","seccion":"Representación de balanzas con ecuaciones","unidad":7,"pagina_pdf":187,"referencia":"Actividad 2","apto_para":["practica","procedimiento_abierto"],"justificacion":"En equilibrio, las masas de los dos platos son iguales.","verificar":"Los bloques 6, x y 2 se transcribieron de la figura de la balanza.","dificultad":300},
  {"id":"CS8-U7-P187-A03","tipo":"ecuacion","enunciado":"Representa con una ecuación la balanza en equilibrio que tiene 8+3x en el plato izquierdo y 4x+x en el derecho.","ecuacion":"8+3*x=4*x+x","incognita":"x","soluciones":["4"],"respuesta":"8+3x=4x+x; por tanto, x=4.","conjunto":"R","seccion":"Representación de balanzas con ecuaciones","unidad":7,"pagina_pdf":187,"referencia":"Actividad 3","apto_para":["practica","procedimiento_abierto"],"verificar":"Los bloques 8, 3x, 4x y x se transcribieron de la figura de la balanza.","dificultad":350},
  {"id":"CS8-U7-P187-A04","tipo":"ecuacion","enunciado":"Representa con una ecuación la balanza en equilibrio que tiene cuatro bloques x en el plato izquierdo y x, 5, x en el derecho.","ecuacion":"4*x=x+5+x","incognita":"x","soluciones":["5/2"],"respuesta":"4x=x+5+x; por tanto, x=5/2.","conjunto":"R","seccion":"Representación de balanzas con ecuaciones","unidad":7,"pagina_pdf":187,"referencia":"Actividad 4","apto_para":["practica","procedimiento_abierto"],"verificar":"Los cuatro bloques x del lado izquierdo y los bloques x, 5, x del derecho se confirmaron en la figura.","dificultad":350},
  {"id":"CS8-U7-P187-A05","tipo":"ecuacion","enunciado":"Representa con una ecuación la balanza en equilibrio que tiene 9, x y 3x en el plato izquierdo, y 7x, 2x y x en el derecho.","ecuacion":"9+x+3*x=7*x+2*x+x","incognita":"x","soluciones":["3/2"],"respuesta":"9+x+3x=7x+2x+x; por tanto, x=3/2.","conjunto":"R","seccion":"Representación de balanzas con ecuaciones","unidad":7,"pagina_pdf":187,"referencia":"Actividad 5","apto_para":["practica","procedimiento_abierto"],"verificar":"Todas las etiquetas se transcribieron de la figura de la balanza.","dificultad":400},
