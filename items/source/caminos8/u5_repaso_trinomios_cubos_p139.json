  {"id":"CS8-U5-P139-A378","tipo":"abierta","enunciado":"Ubica cuatro binomios en los círculos de la gráfica y escribe en cada conexión el trinomio que resulta de multiplicar sus extremos.","respuesta":"Una solución es: superior izquierdo x-3, superior derecho 2x+3, inferior izquierdo 2x+1 e inferior derecho 2x+5. Los productos son: arriba 2x²-3x-9; abajo 4x²+12x+5; izquierda 2x²-5x-3; derecha 4x²+16x+15; diagonales 2x²-x-15 y 4x²+8x+3.","conjunto":"R","seccion":"Repaso de factorización","unidad":5,"pagina_pdf":139,"referencia":"Actividad 378","apto_para":["procedimiento_abierto"],"verificar":"La ubicación puede cambiar mediante simetrías de la gráfica; debe comprobarse cada producto según los extremos conectados.","dificultad":700},
  {"id":"CS8-U5-P139-A379","tipo":"valores_numericos","enunciado":"Completa t³+6t²+□+□ para obtener un cubo perfecto y factorízalo.","exprs":{"polinomio_completo":"t**3+6*t**2+12*t+8"},"respuesta_valores":{"polinomio_completo":"(t+2)**3"},"respuesta":"Las casillas son 12t y 8; t³+6t²+12t+8=(t+2)³.","conjunto":"R","seccion":"Repaso de factorización","unidad":5,"pagina_pdf":139,"referencia":"Actividad 379","apto_para":["practica","procedimiento_abierto"],"dificultad":500},
  {"id":"CS8-U5-P139-A380","tipo":"valores_numericos","enunciado":"Completa 8x³-□+□-1 para obtener un cubo perfecto y factorízalo.","exprs":{"polinomio_completo":"8*x**3-12*x**2+6*x-1"},"respuesta_valores":{"polinomio_completo":"(2*x-1)**3"},"respuesta":"Las casillas son 12x² y 6x; 8x³-12x²+6x-1=(2x-1)³.","conjunto":"R","seccion":"Repaso de factorización","unidad":5,"pagina_pdf":139,"referencia":"Actividad 380","apto_para":["practica","procedimiento_abierto"],"dificultad":500},
  {"id":"CS8-U5-P139-A381","tipo":"valores_numericos","enunciado":"Completa □+□+(1/3)x+1/27 para obtener un cubo perfecto y factorízalo.","exprs":{"polinomio_completo":"x**3+x**2+x/3+1/27"},"respuesta_valores":{"polinomio_completo":"(x+1/3)**3"},"respuesta":"Las casillas son x³ y x²; x³+x²+(1/3)x+1/27=(x+1/3)³.","conjunto":"R","seccion":"Repaso de factorización","unidad":5,"pagina_pdf":139,"referencia":"Actividad 381","apto_para":["practica","procedimiento_abierto"],"dificultad":550},
