  {"id":"CS8-U5-P138-A362","tipo":"simbolico","enunciado":"Factoriza p¹⁰²+1.331q^(6n).","expr":"p**102+1331*q**(6*n)","respuesta":"(p**34+11*q**(2*n))*(p**68-11*p**34*q**(2*n)+121*q**(4*n))","conjunto":"R","seccion":"Repaso de factorización","unidad":5,"pagina_pdf":138,"referencia":"Actividad 362","apto_para":["practica","procedimiento_abierto"],"justificacion":"1.331 es 1331=11³ en la notación de miles del libro.","dificultad":750},
  {"id":"CS8-U5-P138-A363","tipo":"simbolico","enunciado":"Factoriza completamente 512x²y⁴z⁶-8x²⁴.","expr":"512*x**2*y**4*z**6-8*x**24","respuesta":"8*x**2*(8*y**2*z**3-x**11)*(8*y**2*z**3+x**11)","conjunto":"R","seccion":"Repaso de factorización","unidad":5,"pagina_pdf":138,"referencia":"Actividad 363","apto_para":["practica","procedimiento_abierto"],"verificar":"La ampliación confirma x²y⁴z⁶ en el primer término y x²⁴ en el segundo.","dificultad":700},
