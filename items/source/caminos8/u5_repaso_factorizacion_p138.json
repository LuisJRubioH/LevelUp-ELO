  {"id":"CS8-U5-P138-A365","tipo":"simbolico","enunciado":"Factoriza (169/225)x^(2n+4)-100y^(6m-2).","expr":"169*x**(2*n+4)/225-100*y**(6*m-2)","respuesta":"(13*x**(n+2)/15-10*y**(3*m-1))*(13*x**(n+2)/15+10*y**(3*m-1))","conjunto":"R","seccion":"Repaso de factorización","unidad":5,"pagina_pdf":138,"referencia":"Actividad 365","apto_para":["practica","procedimiento_abierto"],"dificultad":700},
