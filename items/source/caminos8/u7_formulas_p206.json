[
  {"id":"CS8-U7-P206-A211","tipo":"abierta","enunciado":"¿Qué es una fórmula?","respuesta":"Es una igualdad que expresa una relación general entre magnitudes mediante variables y constantes, y permite calcular una de ellas a partir de las demás.","conjunto":"R","seccion":"Fórmulas y despeje","unidad":7,"pagina_pdf":206,"referencia":"Actividad 211","apto_para":["procedimiento_abierto"],"dificultad":250},
  {"id":"CS8-U7-P206-A212","tipo":"despeje","enunciado":"Si A=πr² es la fórmula del área de un círculo, despeja el radio en términos del área.","ecuacion":"A=pi*r**2","incognita":"r","solucion":"sqrt(A/pi)","respuesta":"r=√(A/π), tomando la raíz no negativa por tratarse de una longitud.","restricciones":["A>=0"],"conjunto":"R","seccion":"Fórmulas y despeje","unidad":7,"pagina_pdf":206,"referencia":"Actividad 212","apto_para":["practica","procedimiento_abierto"],"dificultad":400},
  {"id":"CS8-U7-P206-A213","tipo":"despeje","enunciado":"Despeja b en 1/f=1/a−1/b.","ecuacion":"1/f=1/a-1/b","incognita":"b","solucion":"a*f/(f-a)","respuesta":"b=af/(f−a).","restricciones":["a!=0","f!=0","f-a!=0"],"conjunto":"R","seccion":"Despeje en fórmulas","unidad":7,"pagina_pdf":206,"referencia":"Actividad 213","apto_para":["practica","procedimiento_abierto"],"dificultad":550},
  {"id":"CS8-U7-P206-A214","tipo":"despeje","enunciado":"Despeja T en PV/T=P₁V₁/T₁.","ecuacion":"P*V/T=P1*V1/T1","incognita":"T","solucion":"P*V*T1/(P1*V1)","respuesta":"T=PVT₁/(P₁V₁).","restricciones":["P1*V1!=0","T1!=0"],"conjunto":"R","seccion":"Despeje en fórmulas","unidad":7,"pagina_pdf":206,"referencia":"Actividad 214","apto_para":["practica","procedimiento_abierto"],"dificultad":500},
  {"id":"CS8-U7-P206-A215","tipo":"despeje","enunciado":"Despeja c en w=as²/c−b.","ecuacion":"w=a*s**2/c-b","incognita":"c","solucion":"a*s**2/(w+b)","respuesta":"c=as²/(w+b).","restricciones":["w+b!=0"],"conjunto":"R","seccion":"Despeje en fórmulas","unidad":7,"pagina_pdf":206,"referencia":"Actividad 215","apto_para":["practica","procedimiento_abierto"],"dificultad":500},
  {"id":"CS8-U7-P206-A216","tipo":"despeje","enunciado":"Despeja n en aₙ=a₁+d(n−1).","ecuacion":"an=a1+d*(n-1)","incognita":"n","solucion":"(an-a1)/d+1","respuesta":"n=(aₙ−a₁)/d+1.","restricciones":["d!=0"],"conjunto":"R","seccion":"Despeje en fórmulas","unidad":7,"pagina_pdf":206,"referencia":"Actividad 216","apto_para":["practica","procedimiento_abierto"],"dificultad":450},
  {"id":"CS8-U7-P206-A217","tipo":"despeje","enunciado":"Despeja r en V=a/[b(c−dr)].","ecuacion":"V=a/(b*(c-d*r))","incognita":"r","solucion":"(b*c*V-a)/(b*d*V)","respuesta":"r=(bcV−a)/(bdV).","restricciones":["b*d*V!=0"],"conjunto":"R","seccion":"Despeje en fórmulas","unidad":7,"pagina_pdf":206,"referencia":"Actividad 217","apto_para":["practica","procedimiento_abierto"],"dificultad":600},
  {"id":"CS8-U7-P206-A218","tipo":"despeje","enunciado":"Despeja c en V=a/[b(c−dr)].","ecuacion":"V=a/(b*(c-d*r))","incognita":"c","solucion":"d*r+a/(b*V)","respuesta":"c=dr+a/(bV).","restricciones":["b*V!=0"],"conjunto":"R","seccion":"Despeje en fórmulas","unidad":7,"pagina_pdf":206,"referencia":"Actividad 218","apto_para":["practica","procedimiento_abierto"],"dificultad":550},
  {"id":"CS8-U7-P206-A219","tipo":"despeje","enunciado":"Despeja k en k(as²+b)/c=w.","ecuacion":"k*(a*s**2+b)/c=w","incognita":"k","solucion":"c*w/(a*s**2+b)","respuesta":"k=cw/(as²+b).","restricciones":["a*s**2+b!=0","c!=0"],"conjunto":"R","seccion":"Despeje en fórmulas","unidad":7,"pagina_pdf":206,"referencia":"Actividad 219","apto_para":["practica","procedimiento_abierto"],"dificultad":500},
  {"id":"CS8-U7-P206-A220","tipo":"despeje","enunciado":"Despeja b en 2am=(3b−5)/x.","ecuacion":"2*a*m=(3*b-5)/x","incognita":"b","solucion":"(2*a*m*x+5)/3","respuesta":"b=(2amx+5)/3.","restricciones":["x!=0"],"conjunto":"R","seccion":"Despeje en fórmulas","unidad":7,"pagina_pdf":206,"referencia":"Actividad 220","apto_para":["practica","procedimiento_abierto"],"dificultad":500},
  {"id":"CS8-U7-P206-A221","tipo":"despeje","enunciado":"Despeja c en s=k−q/c.","ecuacion":"s=k-q/c","incognita":"c","solucion":"q/(k-s)","respuesta":"c=q/(k−s).","restricciones":["k-s!=0"],"conjunto":"R","seccion":"Despeje en fórmulas","unidad":7,"pagina_pdf":206,"referencia":"Actividad 221","apto_para":["practica","procedimiento_abierto"],"dificultad":450},
  {"id":"CS8-U7-P206-A222","tipo":"abierta","enunciado":"Despeja w en (km−t)/w²=3m+a.","respuesta":"w=±√[(km−t)/(3m+a)], con 3m+a≠0 y cociente no negativo si se trabaja en los reales.","conjunto":"R","seccion":"Despeje en fórmulas","unidad":7,"pagina_pdf":206,"referencia":"Actividad 222","apto_para":["procedimiento_abierto"],"dificultad":600},
  {"id":"CS8-U7-P206-A223","tipo":"despeje","enunciado":"Demuestra que al despejar la velocidad inicial en x=v₀t+(1/2)gt² se obtiene v₀=x/t−gt/2.","ecuacion":"x=v0*t+(1/2)*g*t**2","incognita":"v0","solucion":"x/t-g*t/2","respuesta":"v₀=x/t−gt/2, con t≠0.","restricciones":["t!=0"],"conjunto":"R","seccion":"Aplicaciones físicas de fórmulas","unidad":7,"pagina_pdf":206,"referencia":"Actividad 223","apto_para":["practica","procedimiento_abierto"],"dificultad":500},
  {"id":"CS8-U7-P206-A224","tipo":"numerico","enunciado":"Calcula la velocidad inicial de un proyectil si x=560 m, g=10 m/s² y t=8 s en v₀=x/t−gt/2.","expr":"560/8-10*8/2","respuesta":"30","conjunto":"R","seccion":"Aplicaciones físicas de fórmulas","unidad":7,"pagina_pdf":206,"referencia":"Actividad 224","apto_para":["practica","procedimiento_abierto"],"dificultad":400},
  {"id":"CS8-U7-P206-A225","tipo":"abierta","enunciado":"Escribe una fórmula para el área sombreada de una figura formada por un rectángulo de base 2r y altura b coronado por un semicírculo de radio r.","respuesta":"A=2rb+(πr²)/2.","conjunto":"R","seccion":"Construcción de fórmulas geométricas","unidad":7,"pagina_pdf":206,"referencia":"Actividad 225","apto_para":["procedimiento_abierto"],"verificar":"La base 2r del rectángulo se deduce del diámetro del semicírculo; conservar la figura.","dificultad":450},
  {"id":"CS8-U7-P206-A226","tipo":"abierta","enunciado":"Escribe una fórmula para el área de la región sombreada dentro de un cuadrado de lado 2r al retirar cuatro cuartos de círculo de radio r.","respuesta":"A=(2r)²−πr²=(4−π)r².","conjunto":"R","seccion":"Construcción de fórmulas geométricas","unidad":7,"pagina_pdf":206,"referencia":"Actividad 226","apto_para":["procedimiento_abierto"],"verificar":"La región blanca está formada por cuatro cuartos de círculo de radio r.","dificultad":500},
  {"id":"CS8-U7-P206-A227A","tipo":"numerico","enunciado":"La fórmula 400p=a² relaciona el peso límite p en kg con la estatura a en cm. Calcula el peso límite para una persona de 1,8 m.","expr":"180**2/400","respuesta":"81","conjunto":"R","seccion":"Aplicaciones de fórmulas","unidad":7,"pagina_pdf":206,"referencia":"Actividad 227, primera pregunta","apto_para":["practica","procedimiento_abierto"],"dificultad":350},
  {"id":"CS8-U7-P206-A227B","tipo":"numerico","enunciado":"Con 400p=a², halla la estatura en centímetros correspondiente a un peso límite de 60 kg.","expr":"sqrt(400*60)","respuesta":"20*sqrt(60)","respuesta_aproximada":"154,92 cm","conjunto":"R","seccion":"Aplicaciones de fórmulas","unidad":7,"pagina_pdf":206,"referencia":"Actividad 227, segunda pregunta","apto_para":["practica","procedimiento_abierto"],"dificultad":400},
  {"id":"CS8-U7-P206-A228","tipo":"numerico","enunciado":"Una empresa cobra $30 por los primeros 3 minutos y $12 por cada minuto adicional. ¿Cuánto cuesta una llamada de 18 minutos?","expr":"30+12*(18-3)","respuesta":"210","conjunto":"N","seccion":"Aplicaciones de fórmulas","unidad":7,"pagina_pdf":206,"referencia":"Actividad 228","apto_para":["practica","procedimiento_abierto"],"dificultad":350},
  {"id":"CS8-U7-P206-A229","tipo":"abierta","enunciado":"Escribe una fórmula para calcular el costo C de una llamada de t minutos con una empresa que cobra $30 por los primeros 3 minutos y $12 por cada minuto o fracción adicional.","respuesta":"Para t>3, C(t)=30+12⌈t−3⌉; si se consideran minutos enteros, C(t)=30+12(t−3). Para 0<t≤3, C(t)=30.","conjunto":"R","seccion":"Aplicaciones de fórmulas","unidad":7,"pagina_pdf":206,"referencia":"Actividad 229","apto_para":["procedimiento_abierto"],"dificultad":500},
  {"id":"CS8-U7-P206-A230","tipo":"ecuacion","enunciado":"¿Cuánto duró una llamada por la que la empresa cobró $270, usando C=30+12(t−3)?","ecuacion":"30+12*(t-3)=270","incognita":"t","soluciones":["23"],"respuesta":"La llamada duró 23 minutos.","conjunto":"N","seccion":"Aplicaciones de fórmulas","unidad":7,"pagina_pdf":206,"referencia":"Actividad 230","apto_para":["practica","procedimiento_abierto"],"dificultad":400},
  {"id":"CS8-U7-P206-A231","tipo":"despeje","enunciado":"La energía cinética está dada por E=(1/2)mv². Despeja la velocidad v.","ecuacion":"E=(1/2)*m*v**2","incognita":"v","solucion":"sqrt(2*E/m)","respuesta":"v=√(2E/m), tomando la raíz no negativa para la rapidez.","restricciones":["m>0","E>=0"],"conjunto":"R","seccion":"Aplicaciones de fórmulas","unidad":7,"pagina_pdf":206,"referencia":"Actividad 231","apto_para":["practica","procedimiento_abierto"],"dificultad":450},
  {"id":"CS8-U7-P206-A232","tipo":"numerico","enunciado":"Calcula la velocidad de un cuerpo de 60 kg cuya energía cinética es 120 J.","expr":"sqrt(2*120/60)","respuesta":"2","conjunto":"R","seccion":"Aplicaciones de fórmulas","unidad":7,"pagina_pdf":206,"referencia":"Actividad 232","apto_para":["practica","procedimiento_abierto"],"dificultad":350}
