[
  {"id":"CS8-U6-P175-A220","tipo":"abierta","enunciado":"Explica qué es una fracción compleja y determina si se pueden escribir fracciones complejas formadas por números naturales.","respuesta":"Una fracción compleja tiene una fracción en el numerador, en el denominador o en ambos. Sí se pueden formar con números naturales en las fracciones componentes; por ejemplo, (1/2)/(3/4)=2/3.","conjunto":"R","seccion":"Fracciones algebraicas complejas","unidad":6,"pagina_pdf":175,"referencia":"Actividad 220","apto_para":["procedimiento_abierto"],"dificultad":400},
  {"id":"CS8-U6-P175-A221","tipo":"abierta","enunciado":"Describe un procedimiento para simplificar una fracción algebraica compleja.","respuesta":"Se simplifican por separado el numerador y el denominador y luego se divide multiplicando por el recíproco; de forma equivalente, se pueden multiplicar todos los términos por el mínimo común múltiplo de los denominadores internos y reducir el resultado.","conjunto":"R","seccion":"Fracciones algebraicas complejas","unidad":6,"pagina_pdf":175,"referencia":"Actividad 221","apto_para":["procedimiento_abierto"],"dificultad":450},
  {"id":"CS8-U6-P175-A222","tipo":"simbolico","enunciado":"Simplifica (1/x²) ÷ [y³/(x²y⁴)].","expr":"(1/x**2)/(y**3/(x**2*y**4))","respuesta":"y","conjunto":"R","seccion":"Simplificación de fracciones complejas","unidad":6,"pagina_pdf":175,"referencia":"Actividad 222","apto_para":["practica","procedimiento_abierto"],"dificultad":500},
  {"id":"CS8-U6-P175-A223","tipo":"simbolico","enunciado":"Simplifica [17c⁴b/(3cd³)] ÷ [51a²b/(2cd⁴)].","expr":"(17*c**4*b/(3*c*d**3))/(51*a**2*b/(2*c*d**4))","respuesta":"2*c**4*d/(9*a**2)","conjunto":"R","seccion":"Simplificación de fracciones complejas","unidad":6,"pagina_pdf":175,"referencia":"Actividad 223","apto_para":["practica","procedimiento_abierto"],"dificultad":550},
  {"id":"CS8-U6-P175-A224","tipo":"simbolico","enunciado":"Simplifica [1+1/(a−1)] ÷ [1+1/(a²−1)].","expr":"(1+1/(a-1))/(1+1/(a**2-1))","respuesta":"(a+1)/a","conjunto":"R","seccion":"Simplificación de fracciones complejas","unidad":6,"pagina_pdf":175,"referencia":"Actividad 224","apto_para":["practica","procedimiento_abierto"],"dificultad":550},
  {"id":"CS8-U6-P175-A225","tipo":"simbolico","enunciado":"Simplifica [(x²−16)/(x−4)] ÷ [(x+4)/(x−4)].","expr":"((x**2-16)/(x-4))/((x+4)/(x-4))","respuesta":"x-4","conjunto":"R","seccion":"Simplificación de fracciones complejas","unidad":6,"pagina_pdf":175,"referencia":"Actividad 225","apto_para":["practica","procedimiento_abierto"],"dificultad":500},
  {"id":"CS8-U6-P175-A226","tipo":"simbolico","enunciado":"Simplifica (a/b−b/a) ÷ (1+b/a).","expr":"(a/b-b/a)/(1+b/a)","respuesta":"(a-b)/b","conjunto":"R","seccion":"Simplificación de fracciones complejas","unidad":6,"pagina_pdf":175,"referencia":"Actividad 226","apto_para":["practica","procedimiento_abierto"],"dificultad":550},
  {"id":"CS8-U6-P175-A227","tipo":"simbolico","enunciado":"Simplifica (x/2+x) ÷ (x−x/4).","expr":"(x/2+x)/(x-x/4)","respuesta":"2","conjunto":"R","seccion":"Simplificación de fracciones complejas","unidad":6,"pagina_pdf":175,"referencia":"Actividad 227","apto_para":["practica","procedimiento_abierto"],"dificultad":500},
  {"id":"CS8-U6-P175-A228","tipo":"simbolico","enunciado":"Simplifica (1/n−2/n²+3) ÷ (6−1/n−2/n²).","expr":"(1/n-2/n**2+3)/(6-1/n-2/n**2)","respuesta":"(n+1)/(2*n+1)","conjunto":"R","seccion":"Simplificación de fracciones complejas","unidad":6,"pagina_pdf":175,"referencia":"Actividad 228","apto_para":["practica","procedimiento_abierto"],"dificultad":600},
  {"id":"CS8-U6-P175-A229","tipo":"simbolico","enunciado":"Simplifica [(x−3)/(x+3)−(x+3)/(x−3)] ÷ [9/(x²−9)+x²/(x²−9)].","expr":"((x-3)/(x+3)-(x+3)/(x-3))/(9/(x**2-9)+x**2/(x**2-9))","respuesta":"-12*x/(x**2+9)","conjunto":"R","seccion":"Simplificación de fracciones complejas","unidad":6,"pagina_pdf":175,"referencia":"Actividad 229","apto_para":["practica","procedimiento_abierto"],"dificultad":650},
  {"id":"CS8-U6-P175-A230","tipo":"simbolico","enunciado":"Simplifica [(m+2n)/(m−n)+n/m] ÷ [(m+n)/m+3n/(m−n)].","expr":"((m+2*n)/(m-n)+n/m)/((m+n)/m+3*n/(m-n))","respuesta":"1","conjunto":"R","seccion":"Simplificación de fracciones complejas","unidad":6,"pagina_pdf":175,"referencia":"Actividad 230","apto_para":["practica","procedimiento_abierto"],"dificultad":600},
  {"id":"CS8-U6-P175-A231","tipo":"simbolico","enunciado":"Determina si [y−y/(y−y²/(y+1))] ÷ (y/y) tiene como resultado −1.","expr":"(y-y/(y-y**2/(y+1)))/(y/y)","afirmacion":"-1","veredicto":"V","respuesta":"-1","respuesta_texto":"Sí. La fracción se simplifica a −1.","conjunto":"R","seccion":"Identificación de fracciones equivalentes a −1","unidad":6,"pagina_pdf":175,"referencia":"Actividad 231","apto_para":["practica","procedimiento_abierto"],"dificultad":600},
  {"id":"CS8-U6-P175-A232","tipo":"simbolico","enunciado":"Determina si [5−3/(4−1/m)] ÷ [5−3/(4−1/(m−2))] tiene como resultado −1.","expr":"(5-3/(4-1/m))/(5-3/(4-1/(m-2)))","afirmacion":"-1","veredicto":"F","respuesta":"(4*m-9)*(17*m-5)/((4*m-1)*(17*m-39))","respuesta_texto":"No. Se simplifica a (4m−9)(17m−5)/[(4m−1)(17m−39)].","conjunto":"R","seccion":"Identificación de fracciones equivalentes a −1","unidad":6,"pagina_pdf":175,"referencia":"Actividad 232","apto_para":["practica","procedimiento_abierto"],"dificultad":650},
  {"id":"CS8-U6-P175-A233","tipo":"simbolico","enunciado":"Determina si [1/(a+b+c)−1/(a−b+c)] ÷ [1/(a−b+c)−1/(a+b+c)] tiene como resultado −1.","expr":"(1/(a+b+c)-1/(a-b+c))/(1/(a-b+c)-1/(a+b+c))","afirmacion":"-1","veredicto":"V","respuesta":"-1","respuesta_texto":"Sí. El denominador es el opuesto del numerador y el cociente es −1.","conjunto":"R","seccion":"Identificación de fracciones equivalentes a −1","unidad":6,"pagina_pdf":175,"referencia":"Actividad 233","apto_para":["practica","procedimiento_abierto"],"dificultad":600},
  {"id":"CS8-U6-P175-A234","tipo":"simbolico","enunciado":"Elige entre +, −, × y ÷ para que [x+1/(1−1/(1−1/(1−x)))] □ [1−1/(1−1/(x−x/(1−x)))] sea igual a −(2x²−2x)/(x²−x+1).","expr":"(x+1/(1-1/(1-1/(1-x))))*(1-1/(1-1/(x-x/(1-x))))","respuesta":"-(2*x**2-2*x)/(x**2-x+1)","respuesta_texto":"× (multiplicación).","conjunto":"R","seccion":"Operador en fracciones complejas","unidad":6,"pagina_pdf":175,"referencia":"Actividad 234","apto_para":["practica","procedimiento_abierto"],"dificultad":700},
  {"id":"CS8-U6-P175-A235","tipo":"simbolico","enunciado":"Simplifica {[(a²−1)/(a²+1)−(a²+1)/(a²−1)] ÷ [(a−1)/(a+1)−(a+1)/(a−1)]} ÷ [(a+1/a)/a²−1].","expr":"(((a**2-1)/(a**2+1)-(a**2+1)/(a**2-1))/((a-1)/(a+1)-(a+1)/(a-1)))/((a+1/a)/a**2-1)","respuesta":"-a**4/((a**2+1)*(a**3-a**2-1))","conjunto":"R","seccion":"Operaciones con fracciones complejas","unidad":6,"pagina_pdf":175,"referencia":"Actividad 235","apto_para":["practica","procedimiento_abierto"],"dificultad":750},
  {"id":"CS8-U6-P175-A236","tipo":"simbolico","enunciado":"Simplifica {[(x²−1)/(x²+2x+1)·(2x²−8x−10)/(x−1)] ÷ [(2x+2)/(x²+x−2) ÷ (x+1)/(x³−4x²−7x+10)]} · [(1/(x+1)−1/x) ÷ (1/(x+1)+1/x)].","expr":"(((x**2-1)/(x**2+2*x+1)*(2*x**2-8*x-10)/(x-1))/(((2*x+2)/(x**2+x-2))/((x+1)/(x**3-4*x**2-7*x+10))))*((1/(x+1)-1/x)/(1/(x+1)+1/x))","respuesta":"-1/(2*x+1)","conjunto":"R","seccion":"Operaciones con fracciones complejas","unidad":6,"pagina_pdf":175,"referencia":"Actividad 236","apto_para":["practica","procedimiento_abierto"],"dificultad":800},
  {"id":"CS8-U6-P175-A237","tipo":"simbolico","enunciado":"Determina si 2 ÷ (1/vf+1/v0) es equivalente a la velocidad media (vf+v0)/2.","expr":"2/(1/vf+1/v0)","afirmacion":"(vf+v0)/2","veredicto":"F","respuesta":"2*v0*vf/(v0+vf)","respuesta_texto":"No. La expresión es 2v0vf/(v0+vf), la media armónica de las velocidades.","conjunto":"R","seccion":"Velocidad media","unidad":6,"pagina_pdf":175,"referencia":"Actividad 237","apto_para":["practica","procedimiento_abierto"],"dificultad":600},
  {"id":"CS8-U6-P175-A238","tipo":"simbolico","enunciado":"Determina si (1/vf+1/v0) ÷ [2/(vfv0)] es equivalente a la velocidad media (vf+v0)/2.","expr":"(1/vf+1/v0)/(2/(vf*v0))","afirmacion":"(vf+v0)/2","veredicto":"V","respuesta":"(vf+v0)/2","respuesta_texto":"Sí. La expresión se simplifica a (vf+v0)/2.","conjunto":"R","seccion":"Velocidad media","unidad":6,"pagina_pdf":175,"referencia":"Actividad 238","apto_para":["practica","procedimiento_abierto"],"dificultad":600},
  {"id":"CS8-U6-P175-A239","tipo":"simbolico","enunciado":"Determina si [1/(vfv0)] ÷ (1/vf+1/v0) es equivalente a la velocidad media (vf+v0)/2.","expr":"(1/(vf*v0))/(1/vf+1/v0)","afirmacion":"(vf+v0)/2","veredicto":"F","respuesta":"1/(v0+vf)","respuesta_texto":"No. La expresión se simplifica a 1/(v0+vf).","conjunto":"R","seccion":"Velocidad media","unidad":6,"pagina_pdf":175,"referencia":"Actividad 239","apto_para":["practica","procedimiento_abierto"],"dificultad":600}
