  {"id":"CS8-U6-P151-A55","tipo":"abierta","enunciado":"Organiza los seis polinomios impresos en dos grupos de tres con el mismo mcm.","respuesta":"Grupo 1: 10m²+13m-3; 2m+8; 2m²-5m-12. Grupo 2: 5m²-21m+4; 2m²-32; 2m²+11m+12. Ambos tienen mcm 2(5m-1)(2m+3)(m-4)(m+4).","conjunto":"R","seccion":"Organización por MCM","unidad":6,"pagina_pdf":151,"referencia":"Actividad 55","apto_para":["procedimiento_abierto"],"dificultad":750},
