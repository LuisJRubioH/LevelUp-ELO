[
  {"id":"CS8-U6-P163-EJ01","tipo":"simbolico","enunciado":"Dos resistencias en paralelo tienen valores R₁=x²-xy y R₂=xy. Calcula la resistencia equivalente usando 1/Rₑ=1/R₁+1/R₂.","expr":"1/(1/(x**2-x*y)+1/(x*y))","respuesta":"y*(x-y)","conjunto":"R","seccion":"Aplicación: resistencias en paralelo","unidad":6,"pagina_pdf":163,"referencia":"Ejemplo resuelto 2","apto_para":["practica","procedimiento_abierto"],"restricciones":["x!=0","y!=0","x!=y"],"dificultad":600},
  {"id":"CS8-U6-P163-A158","tipo":"simbolico","enunciado":"Si A=1/(x²-1), B=3/(2x-2) y C=3/(3x+3), calcula A+B-C.","expr":"1/(x**2-1)+3/(2*x-2)-3/(3*x+3)","respuesta":"(x+7)/(2*(x-1)*(x+1))","conjunto":"R","seccion":"Cálculo de expresiones racionales","unidad":6,"pagina_pdf":163,"referencia":"Actividad 158","apto_para":["practica","procedimiento_abierto"],"dificultad":550},
  {"id":"CS8-U6-P163-A159","tipo":"simbolico","enunciado":"Si A=1/(x²-1), B=3/(2x-2) y C=3/(3x+3), calcula A-B+C.","expr":"1/(x**2-1)-3/(2*x-2)+3/(3*x+3)","respuesta":"-(x+3)/(2*(x-1)*(x+1))","conjunto":"R","seccion":"Cálculo de expresiones racionales","unidad":6,"pagina_pdf":163,"referencia":"Actividad 159","apto_para":["practica","procedimiento_abierto"],"dificultad":550},
  {"id":"CS8-U6-P163-A160","tipo":"simbolico","enunciado":"Resuelve (12+3x)/(x+6) - (3+8x)/(x+6) + (3+7x)/(x+6).","expr":"(12+3*x)/(x+6)-(3+8*x)/(x+6)+(3+7*x)/(x+6)","respuesta":"2","conjunto":"R","seccion":"Operaciones con fracciones algebraicas","unidad":6,"pagina_pdf":163,"referencia":"Actividad 160","apto_para":["practica","procedimiento_abierto"],"dificultad":450},
  {"id":"CS8-U6-P163-A161","tipo":"simbolico","enunciado":"Resuelve (b²+6b-7)/(b-5) - (b²-5b)/(b-5) + (b+8)/(5-b).","expr":"(b**2+6*b-7)/(b-5)-(b**2-5*b)/(b-5)+(b+8)/(5-b)","respuesta":"5*(2*b-3)/(b-5)","conjunto":"R","seccion":"Operaciones con fracciones algebraicas","unidad":6,"pagina_pdf":163,"referencia":"Actividad 161","apto_para":["practica","procedimiento_abierto"],"dificultad":550},
  {"id":"CS8-U6-P163-A162","tipo":"simbolico","enunciado":"Resuelve (y+12)/(12y+24) + y/(3y+6) - 1/(6y+12).","expr":"(y+12)/(12*y+24)+y/(3*y+6)-1/(6*y+12)","respuesta":"5/12","conjunto":"R","seccion":"Operaciones con fracciones algebraicas","unidad":6,"pagina_pdf":163,"referencia":"Actividad 162","apto_para":["practica","procedimiento_abierto"],"dificultad":500},
  {"id":"CS8-U6-P163-A163","tipo":"simbolico","enunciado":"Resuelve 1/(ax) - 1/(a²+ax) + 1/(a+x) - 2/(a²-x²).","expr":"1/(a*x)-1/(a**2+a*x)+1/(a+x)-2/(a**2-x**2)","respuesta":"(-a*x-a+x**2+3*x)/(x*(x-a)*(a+x))","conjunto":"R","seccion":"Operaciones con fracciones algebraicas","unidad":6,"pagina_pdf":163,"referencia":"Actividad 163","apto_para":["practica","procedimiento_abierto"],"dificultad":700},
  {"id":"CS8-U6-P163-A164","tipo":"simbolico","enunciado":"Un triángulo tiene perímetro (m+4)/[2(m-2)], dos lados de (m-1)/(2m-4) y (m+8)/(m²-4), y un tercer lado desconocido. Determina ese lado.","expr":"(m+4)/(2*(m-2))-(m-1)/(2*m-4)-(m+8)/(m**2-4)","respuesta":"3/(2*(m+2))","conjunto":"R","seccion":"Dimensiones desconocidas","unidad":6,"pagina_pdf":163,"referencia":"Actividad 164","apto_para":["practica","procedimiento_abierto"],"verificar":"El perímetro y los dos lados conocidos se transcribieron de la figura.","dificultad":600},
  {"id":"CS8-U6-P163-A165","tipo":"simbolico","enunciado":"Un cuadrilátero tiene perímetro (14x+53)/(2x²+14x+24), tres lados de 3/(2x+8), 3/(x+3) y 1/(2x+6), y un cuarto lado desconocido. Determina ese lado.","expr":"(14*x+53)/(2*x**2+14*x+24)-3/(2*x+8)-3/(x+3)-1/(2*x+6)","respuesta":"2/(x+3)","conjunto":"R","seccion":"Dimensiones desconocidas","unidad":6,"pagina_pdf":163,"referencia":"Actividad 165","apto_para":["practica","procedimiento_abierto"],"verificar":"El perímetro y los tres lados conocidos se transcribieron de la figura.","dificultad":650}
]
