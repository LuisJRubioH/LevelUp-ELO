[
  {"id":"CS8-U6-P148-A01","tipo":"abierta","enunciado":"Explica con un ejemplo cómo se halla el mcd de dos o más monomios.","respuesta":"Se halla el mcd de los coeficientes y se multiplican las variables comunes con su menor exponente. Ejemplo: mcd(12x³y²,18x²y⁴)=6x²y².","conjunto":"R","seccion":"Máximo común divisor","unidad":6,"pagina_pdf":148,"referencia":"Actividad 1","apto_para":["procedimiento_abierto"],"dificultad":400},
  {"id":"CS8-U6-P148-A02","tipo":"abierta","enunciado":"Si se tienen dos polinomios que no se pueden factorizar, ¿cuál es su mcd? Explica.","respuesta":"En la lectura escolar prevista, el mcd es 1 cuando son polinomios irreducibles distintos y no asociados.","conjunto":"R","seccion":"Máximo común divisor","unidad":6,"pagina_pdf":148,"referencia":"Actividad 2","apto_para":["procedimiento_abierto"],"verificar":"Que ambos polinomios sean irreducibles no basta si son iguales o asociados; la respuesta 1 requiere que no compartan un factor irreducible.","dificultad":450},
  {"id":"CS8-U6-P148-A03","tipo":"abierta","enunciado":"¿Puede ser que el mcd de dos o más polinomios sea un número? Explica con un ejemplo.","respuesta":"Sí. Por ejemplo, mcd(2x+2,4x²+6)=2.","conjunto":"R","seccion":"Máximo común divisor","unidad":6,"pagina_pdf":148,"referencia":"Actividad 3","apto_para":["procedimiento_abierto"],"dificultad":400},
