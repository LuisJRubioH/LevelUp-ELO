[
  {"id":"CS8-U6-P177-A260","tipo":"simbolico","enunciado":"Escribe el término que hace verdadera la igualdad 2/(x+3)+□−(4x−7)/(x²−x−6)=1/(x+3).","expr":"1/(x+3)-2/(x+3)+(4*x-7)/(x**2-x-6)","respuesta":"3*(x**2+2*x-5)/((x-3)*(x+2)*(x+3))","conjunto":"R","seccion":"Término faltante en una igualdad","unidad":6,"pagina_pdf":177,"referencia":"Actividad 260","apto_para":["practica","procedimiento_abierto"],"dificultad":650},
  {"id":"CS8-U6-P177-A261","tipo":"simbolico","enunciado":"Escribe el término que hace verdadera la igualdad (a−b)/(a+b)−(a+b)/(a−b)+□=4a/(a+b).","expr":"4*a/(a+b)-(a-b)/(a+b)+(a+b)/(a-b)","respuesta":"4*a**2/((a-b)*(a+b))","conjunto":"R","seccion":"Término faltante en una igualdad","unidad":6,"pagina_pdf":177,"referencia":"Actividad 261","apto_para":["practica","procedimiento_abierto"],"dificultad":600},
  {"id":"CS8-U6-P177-A262","tipo":"simbolico","enunciado":"Escribe el término que hace verdadera la igualdad □·(1/x÷1/(x−1))=2(x−1)/x².","expr":"(2*(x-1)/x**2)/((1/x)/(1/(x-1)))","respuesta":"2/x","conjunto":"R","seccion":"Término faltante en una igualdad","unidad":6,"pagina_pdf":177,"referencia":"Actividad 262","apto_para":["practica","procedimiento_abierto"],"dificultad":550},
  {"id":"CS8-U6-P177-A263","tipo":"simbolico","enunciado":"Realiza y simplifica 9x²y/(3x)−5x²y/(3x)+[4x²y²/(3x²)]÷[5y/(2x)].","expr":"9*x**2*y/(3*x)-5*x**2*y/(3*x)+(4*x**2*y**2/(3*x**2))/(5*y/(2*x))","respuesta":"28*x*y/15","conjunto":"R","seccion":"Operaciones entre fracciones algebraicas","unidad":6,"pagina_pdf":177,"referencia":"Actividad 263","apto_para":["practica","procedimiento_abierto"],"dificultad":550},
  {"id":"CS8-U6-P177-A264","tipo":"simbolico","enunciado":"Realiza y simplifica (x+5)/(3y)−[(5x+30)/(9y²)]·[3y/(x+4)].","expr":"(x+5)/(3*y)-(5*x+30)/(9*y**2)*(3*y)/(x+4)","respuesta":"(x**2+4*x-10)/(3*y*(x+4))","conjunto":"R","seccion":"Operaciones entre fracciones algebraicas","unidad":6,"pagina_pdf":177,"referencia":"Actividad 264","apto_para":["practica","procedimiento_abierto"],"dificultad":600},
  {"id":"CS8-U6-P177-A265","tipo":"simbolico","enunciado":"Realiza y simplifica [(x⁴−1)/(x⁴−81)]·[(x²−1)/(x+1)]÷[(x²+1)/(x²+9)].","expr":"(x**4-1)/(x**4-81)*(x**2-1)/(x+1)/((x**2+1)/(x**2+9))","respuesta":"(x-1)**2*(x+1)/((x-3)*(x+3))","conjunto":"R","seccion":"Operaciones entre fracciones algebraicas","unidad":6,"pagina_pdf":177,"referencia":"Actividad 265","apto_para":["practica","procedimiento_abierto"],"dificultad":650},
  {"id":"CS8-U6-P177-A266","tipo":"simbolico","enunciado":"Realiza y simplifica [a²/(a−1)]·{a³/(a+1)+(a−1)/(a⁶−2a³+1)}.","expr":"a**2/(a-1)*(a**3/(a+1)+(a-1)/(a**6-2*a**3+1))","respuesta":"a**2*(a**2+1)*(a**6+a**5-2*a**3-a**2+a+1)/((a-1)**2*(a+1)*(a**2+a+1)**2)","conjunto":"R","seccion":"Operaciones entre fracciones algebraicas","unidad":6,"pagina_pdf":177,"referencia":"Actividad 266","apto_para":["practica","procedimiento_abierto"],"verificar":"La expresión larga, incluidos el signo + y el denominador a⁶−2a³+1, fue confirmada en la imagen ampliada a 700 dpi.","dificultad":750},
  {"id":"CS8-U6-P177-A267","tipo":"simbolico","enunciado":"Realiza y simplifica {[(x²−x−12)/(x²−2x−8)]·[(x²+4x+4)/(x²+5x+6)]}÷[(x−7)/(x+6)].","expr":"((x**2-x-12)/(x**2-2*x-8)*(x**2+4*x+4)/(x**2+5*x+6))/((x-7)/(x+6))","respuesta":"(x+6)/(x-7)","conjunto":"R","seccion":"Operaciones entre fracciones algebraicas","unidad":6,"pagina_pdf":177,"referencia":"Actividad 267","apto_para":["practica","procedimiento_abierto"],"dificultad":700},
  {"id":"CS8-U6-P177-A268","tipo":"simbolico","enunciado":"Un rectángulo tiene altura 49/(x−y), ancho total (x−y)/(x²+xy)+1/(xy) y una franja no sombreada de ancho x/(xy+y²). Determina una expresión para el área sombreada.","expr":"49/(x-y)*((x-y)/(x**2+x*y)+1/(x*y)-x/(x*y+y**2))","respuesta":"49*(-x**2+x*y+x-y**2+y)/(x*y*(x-y)*(x+y))","conjunto":"R","seccion":"Área con expresiones racionales","unidad":6,"pagina_pdf":177,"referencia":"Actividad 268","apto_para":["practica","procedimiento_abierto"],"verificar":"Las tres medidas y la identificación de la franja no sombreada dependen de la figura original.","dificultad":700},
  {"id":"CS8-U6-P177-A269","tipo":"simbolico","enunciado":"Simplifica [x−2/(x+3)]÷[x+(2x−3)/(x+3)].","expr":"(x-2/(x+3))/(x+(2*x-3)/(x+3))","respuesta":"(x**2+3*x-2)/(x**2+5*x-3)","conjunto":"R","seccion":"Fracciones algebraicas complejas","unidad":6,"pagina_pdf":177,"referencia":"Actividad 269","apto_para":["practica","procedimiento_abierto"],"dificultad":600},
  {"id":"CS8-U6-P177-A270","tipo":"simbolico","enunciado":"Simplifica [1+1/(a−1)]÷[a/(a+1)−a²/(a²−1)].","expr":"(1+1/(a-1))/(a/(a+1)-a**2/(a**2-1))","respuesta":"-a-1","conjunto":"R","seccion":"Fracciones algebraicas complejas","unidad":6,"pagina_pdf":177,"referencia":"Actividad 270","apto_para":["practica","procedimiento_abierto"],"dificultad":650},
  {"id":"CS8-U6-P177-A271","tipo":"simbolico","enunciado":"Averigua qué estudiante obtuvo el resultado de (a+3)/(6b)÷[(a²−9)/(2b)].","expr":"(a+3)/(6*b)/((a**2-9)/(2*b))","respuesta":"1/(3*(a-3))","respuesta_texto":"Erica obtuvo 1/[3(a−3)].","conjunto":"R","seccion":"Identificación de una operación por su resultado","unidad":6,"pagina_pdf":177,"referencia":"Actividad 271","apto_para":["practica","procedimiento_abierto"],"dificultad":500},
  {"id":"CS8-U6-P177-A272","tipo":"simbolico","enunciado":"Averigua qué estudiante obtuvo el resultado de (3a²+3ab)/b÷[(ab+b²)/(3a)].","expr":"(3*a**2+3*a*b)/b/((a*b+b**2)/(3*a))","respuesta":"9*a**2/b**2","respuesta_texto":"Ana obtuvo 9a²/b².","conjunto":"R","seccion":"Identificación de una operación por su resultado","unidad":6,"pagina_pdf":177,"referencia":"Actividad 272","apto_para":["practica","procedimiento_abierto"],"dificultad":500},
  {"id":"CS8-U6-P177-A273","tipo":"simbolico","enunciado":"Averigua qué estudiante obtuvo el resultado de [(a²+b²)/(a−3)]·(a/4)·(3b/a).","expr":"(a**2+b**2)/(a-3)*a/4*3*b/a","respuesta":"3*b*(a**2+b**2)/(4*(a-3))","respuesta_texto":"Fabio obtuvo (3a²b+3b³)/(4a−12).","conjunto":"R","seccion":"Identificación de una operación por su resultado","unidad":6,"pagina_pdf":177,"referencia":"Actividad 273","apto_para":["practica","procedimiento_abierto"],"dificultad":550}
