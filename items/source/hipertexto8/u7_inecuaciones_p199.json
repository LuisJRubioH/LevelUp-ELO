  {
    "id": "HT8-U7-P199-A1a",
    "tipo": "abierta",
    "enunciado": "Nombra cada una de las propiedades de las desigualdades y da un ejemplo.",
    "respuesta": "1. Propiedad aditiva: sumar o restar la misma cantidad conserva el sentido; por ejemplo, de $3<5$ se sigue $3+2<5+2$. 2. Multiplicación o división por una cantidad positiva: conserva el sentido; de $3<5$ se sigue $3\\cdot2<5\\cdot2$. 3. Multiplicación o división por una cantidad negativa: invierte el sentido; de $3<5$ se sigue $3(-2)>5(-2)$.",
    "conjunto": "R",
    "seccion": "Propiedades de las desigualdades",
    "unidad": 7,
    "pagina_pdf": 199,
    "referencia": "Actividad 1, primera pregunta",
    "apto_para": ["procedimiento_abierto"],
    "nota": "Se siguen las tres propiedades enumeradas por el libro en la página 196.",
    "dificultad": 950
  },
