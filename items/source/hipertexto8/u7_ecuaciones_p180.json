    "id": "HT8-U7-P180-A1",
    "tipo": "abierta",
    "enunciado": "¿Qué pasos se deben realizar para solucionar una ecuación de la forma $ax+b=cx+d$?",
    "respuesta": "Se reúnen los términos con $x$ en un miembro y los independientes en el otro: $(a-c)x=d-b$. Si $a\\ne c$, se divide entre $a-c$ y queda $x=(d-b)/(a-c)$. Si $a=c$, hay infinitas soluciones cuando $b=d$ y ninguna cuando $b\\ne d$.",
    "conjunto": "Q",
    "seccion": "Ecuaciones de la forma ax+b=cx+d",
    "unidad": 7,
    "pagina_pdf": 180,
    "referencia": "Actividad 1",
    "apto_para": ["procedimiento_abierto"],
    "nota": "Los casos $a=c$ deben separarse porque no se puede dividir entre cero.",
    "dificultad": 1000
  },
