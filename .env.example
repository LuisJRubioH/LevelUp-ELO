# Copiar a .env para desarrollo local. .env está gitignoreado — nunca commitear secretos.
# This repository is not deployed; for the final environment see docs/transfer.md § 3.

# ── Base de datos ────────────────────────────────────────────────────────────
# Vacío → SQLite local en data/elo_database.db (suficiente para desarrollo).
# Supabase: usar el connection pooler, PUERTO 6543, no el 5432 directo.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ── Supabase Storage — bucket privado `procedimientos` ───────────────────────
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_KEY=<service_role key>

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_A_LONG_RANDOM_STRING

# ── Admin ────────────────────────────────────────────────────────────────────
ADMIN_USER=admin
ADMIN_PASSWORD=CHANGE_ME

# ── CORS — lista JSON de orígenes permitidos ─────────────────────────────────
CORS_ORIGINS=["http://localhost:5173"]

# ── Acceso ───────────────────────────────────────────────────────────────────
# Registro público cerrado por defecto: las cuentas las crea el administrador.
# PUBLIC_REGISTRATION_ENABLED=true
# Límites del login (por cuenta y global) y del registro público (por dirección).
# RATE_LIMIT_LOGIN_ACCOUNT=10/minute
# RATE_LIMIT_LOGIN_GLOBAL=300/minute
# RATE_LIMIT_REGISTER=20/minute

# ── IA — opcional; sin key la IA degrada con gracia ──────────────────────────
# El proveedor se detecta por el prefijo: gsk_ Groq · sk-ant- Anthropic ·
# sk- OpenAI · AIzaSy Google.
# SYSTEM_AI_API_KEY=

# ── Frontend (frontend/.env.local) ───────────────────────────────────────────
# VITE_API_URL=http://localhost:8000
